; Flappy Bird - Classic side-scrolling game
;
; Gameplay:
; - Press A to flap and fly upward
; - Avoid the pipes (top and bottom)
; - Bird dies if it hits pipes or boundaries
; - Press START to restart after game over
;
; Features:
; - 8.8 fixed-point subpixel physics
; - Animated bird sprite
; - Visual boundaries
; - Sound effects
;
; BUILD:
;   make examples-se
;   ./build/tiny16-emu build/flappy_se.tiny16

; Tileset: tiles at 0x5000, palette at 0x9200
(include "../examples/includes/tileset.inc")


(def OAM_ADDR           0x9000)
(def OAM_HI             (hi OAM_ADDR))
(def OAM_LO             (lo OAM_ADDR))

; Sprite attributes
(def SPRITE_BEHIND_BG   0x20)

(def TILEMAP_ADDR       0x7000)
(def TILEMAP_HI         (hi TILEMAP_ADDR))

(def MMIO_BASE          0xBF00)
(def KEYS_PRESSED       (+ MMIO_BASE 0x01))
(def FRAME_COUNT        (+ MMIO_BASE 0x22))
(def PPU_CTRL           (+ MMIO_BASE 0x30))
(def PPU_BG_SPRITES     0x83)

; APU
(def APU_CTRL           (+ MMIO_BASE 0x40))
(def APU_CH0_FREQ_LO    (+ MMIO_BASE 0x42))
(def APU_CH0_FREQ_HI    (+ MMIO_BASE 0x43))
(def APU_CH0_VOL        (+ MMIO_BASE 0x44))
(def APU_CH0_CTRL       (+ MMIO_BASE 0x45))
(def APU_CH0_ENV_AD     (+ MMIO_BASE 0x51))
(def APU_CH0_ENV_SR     (+ MMIO_BASE 0x52))
(def APU_CH0_LEN        (+ MMIO_BASE 0x5B))
(def APU_CH3_PERIOD     (+ MMIO_BASE 0x4E))
(def APU_CH3_VOL        (+ MMIO_BASE 0x4F))
(def APU_CH3_CTRL       (+ MMIO_BASE 0x50))
(def APU_CH3_ENV_AD     (+ MMIO_BASE 0x57))
(def APU_CH3_ENV_SR     (+ MMIO_BASE 0x58))
(def APU_CH3_LEN        (+ MMIO_BASE 0x5E))

(def KEY_START          0x02)
(def KEY_A              0x04)

; Game states
(def STATE_PLAYING      0)
(def STATE_DEAD         1)

; Playable area (inside boundaries)
(def AREA_TOP           20)
(def AREA_BOTTOM        108)

; Bird
(def BIRD_X             24)
(def BIRD_START_Y       60)

; Pipe
(def PIPE_GAP           34)
(def PIPE_WIDTH         8)
(def PIPE_SPEED         1)
(def PIPE_SPAWN_X       136)
(def PIPE_SPACING       70)
(def GAP_MIN            38)
(def GAP_RANGE          50)

; Physics (8.8 fixed-point constants)
(def GRAVITY_HI         0)
(def GRAVITY_LO         70)         ; ~0.27 per frame
(def FLAP_VEL_HI        (- 256 3))  ; -3 upward velocity (two's complement)
(def FLAP_VEL_LO        0)
(def MAX_FALL_HI        4)
(def MAX_FALL_LO        0)

; =============================================================================
; Constants - Tiles
; =============================================================================

; Bird animation frames
(def TILE_BIRD_UP       101)
(def TILE_BIRD_MID      103)
(def TILE_BIRD_DOWN     104)

; Pipe tiles
(def TILE_PIPE_CAP_UP   39)
(def TILE_PIPE_BODY     55)
(def TILE_PIPE_CAP_DN   71)

; Boundary tiles
; Sky: top 2 rows
(def TILE_SKY_TOP       2)
(def TILE_SKY_BOT       1)
; Ground: bottom 3 rows
(def TILE_GROUND_TOP    81)
(def TILE_GROUND_MID    97)
(def TILE_GROUND_BOT    113)

; Digit tiles (ASCII font at tiles 128-255)
; ASCII '0' = 48, so digit 0 is at tile 128 + 48 = 176
(def TILE_DIGIT_0       144)

; Score display position (top right)
(def SCORE_X            112)
(def SCORE_Y            4)

; =============================================================================
; Helpers
; =============================================================================

(defn read-frame ()
  (peek16 FRAME_COUNT))

(defn wait-frame ()
  (let (last (peek16 last_frame)
        curr (read-frame))
    (while (= curr last)
      (set curr (read-frame)))
    (poke16 last_frame curr)))

(defn mod-by (v d)
  (let (r v)
    (while (>= r d)
      (set r (- r d)))
    r))

(defn oam-addr (idx)
  (+ OAM_LO (<< idx 2)))

(defn draw-spr (idx y x tile)
  (let (a (oam-addr idx))
    (poke OAM_HI a y)
    (poke OAM_HI (+ a 1) x)
    (poke OAM_HI (+ a 2) tile)
    (poke OAM_HI (+ a 3) 0)))

(defn draw-spr-attr (idx y x tile attr)
  (let (a (oam-addr idx))
    (poke OAM_HI a y)
    (poke OAM_HI (+ a 1) x)
    (poke OAM_HI (+ a 2) tile)
    (poke OAM_HI (+ a 3) attr)))

(defn render ()
  (poke16 PPU_CTRL PPU_BG_SPRITES))

; =============================================================================
; Tilemap Helpers
; =============================================================================

; Write a tile to tilemap at (tx, ty) - tile coordinates
; Tilemap entry = 2 bytes: tile index + attribute
; Address = 0x7000 + (ty * 128 + tx) * 2
; Each row = 128 tiles * 2 bytes = 256 bytes (one page)
; High byte = 0x70 + ty
; Low byte = tx * 2
(defn tilemap-set (tx ty tile)
  (let (addr-hi (+ TILEMAP_HI ty)
        addr-lo (<< tx 1))
    (poke addr-hi addr-lo tile)
    (poke addr-hi (+ addr-lo 1) 0)))

; Fill a row of tilemap with a tile
(defn tilemap-fill-row (ty tile)
  (let (x 0)
    (while (< x 16)
      (tilemap-set x ty tile)
      (set x (inc x)))))

; Initialize tilemap with sky and ground boundaries
(defn init-tilemap ()
  ; Sky: 3 rows at top (tile rows 0, 1, 2)
  ; Row 0 (y=0): tile 2
  (tilemap-fill-row 0 TILE_SKY_TOP)
  ; Row 1 (y=8): tile 2
  (tilemap-fill-row 1 TILE_SKY_TOP)
  ; Row 2 (y=16): tile 1 (closest to play area)
  (tilemap-fill-row 2 TILE_SKY_BOT)

  ; Ground: 3 rows at bottom (tile rows 13, 14, 15)
  ; AREA_BOTTOM = 108, so tile row = 108/8 = 13
  ; Row 13 (y=104): tile 51
  (tilemap-fill-row 13 TILE_GROUND_TOP)
  ; Row 14 (y=112): tile 61
  (tilemap-fill-row 14 TILE_GROUND_MID)
  ; Row 15 (y=120): tile 71
  (tilemap-fill-row 15 TILE_GROUND_BOT))

; =============================================================================
; Sound Effects
; =============================================================================

(defn apu-init ()
  (poke16 APU_CTRL 0x81))

(defn sfx-flap ()
  (poke16 APU_CH0_ENV_AD 0x11)
  (poke16 APU_CH0_ENV_SR 0x81)
  (poke16 APU_CH0_LEN 3)
  (poke16 APU_CH0_FREQ_LO 0xC8)
  (poke16 APU_CH0_FREQ_HI 0x07)
  (poke16 APU_CH0_VOL 0x12)
  (poke16 APU_CH0_CTRL 0x03))

(defn sfx-die ()
  (poke16 APU_CH3_ENV_AD 0x15)
  (poke16 APU_CH3_ENV_SR 0x04)
  (poke16 APU_CH3_LEN 18)
  (poke16 APU_CH3_PERIOD 9)
  (poke16 APU_CH3_VOL 14)
  (poke16 APU_CH3_CTRL 0x03))

(defn sfx-score ()
  (poke16 APU_CH0_ENV_AD 0x11)
  (poke16 APU_CH0_ENV_SR 0x61)
  (poke16 APU_CH0_LEN 4)
  (poke16 APU_CH0_FREQ_LO 0xD0)
  (poke16 APU_CH0_FREQ_HI 0x07)
  (poke16 APU_CH0_VOL 0x2C)
  (poke16 APU_CH0_CTRL 0x03))

; =============================================================================
; Fixed-Point Helpers
; =============================================================================

; Add gravity to velocity
(defn add-gravity ()
  (let (v-lo (peek16 bird_vel_lo)
        new-lo (+ v-lo GRAVITY_LO)
        carry (if (< new-lo v-lo) 1 0)
        v-hi (peek16 bird_vel_hi)
        new-hi (+ v-hi (+ GRAVITY_HI carry)))
    (poke16 bird_vel_hi new-hi)
    (poke16 bird_vel_lo new-lo)))

; Add velocity to position
(defn apply-velocity ()
  (let (y-lo (peek16 bird_y_lo)
        v-lo (peek16 bird_vel_lo)
        new-lo (+ y-lo v-lo)
        carry (if (< new-lo y-lo) 1 0)
        y-hi (peek16 bird_y_hi)
        v-hi (peek16 bird_vel_hi)
        new-hi (+ y-hi (+ v-hi carry)))
    (poke16 bird_y_hi new-hi)
    (poke16 bird_y_lo new-lo)))

; Set flap velocity
(defn set-flap-velocity ()
  (poke16 bird_vel_hi FLAP_VEL_HI)
  (poke16 bird_vel_lo FLAP_VEL_LO))

; Clamp fall speed
(defn clamp-velocity ()
  (let (v-hi (peek16 bird_vel_hi))
    (if (< v-hi 128)
        (if (> v-hi MAX_FALL_HI)
            (do
              (poke16 bird_vel_hi MAX_FALL_HI)
              (poke16 bird_vel_lo MAX_FALL_LO))
            0)
        0)))

; =============================================================================
; Game Init
; =============================================================================

(defn hide-sprites ()
  (let (i 0)
    (while (< i 64)
      (draw-spr i 255 0 0)
      (set i (inc i)))))

(defn init-pipe ()
  (let (seed (read-frame)
        gap1 (+ GAP_MIN (mod-by seed GAP_RANGE))
        gap2 (+ GAP_MIN (mod-by (+ seed 37) GAP_RANGE)))
    ; Pipe 1
    (poke16 pipe1_x PIPE_SPAWN_X)
    (poke16 pipe1_gap_y gap1)
    (poke16 pipe1_passed 0)
    ; Pipe 2 (offset by PIPE_SPACING)
    (poke16 pipe2_x (+ PIPE_SPAWN_X PIPE_SPACING))
    (poke16 pipe2_gap_y gap2)
    (poke16 pipe2_passed 0)))

(defn init-game ()
  (hide-sprites)
  ; Bird position (8.8)
  (poke16 bird_y_hi BIRD_START_Y)
  (poke16 bird_y_lo 0)
  ; Velocity (8.8)
  (poke16 bird_vel_hi 0)
  (poke16 bird_vel_lo 0)
  ; State
  (poke16 game_state STATE_PLAYING)
  (poke16 score 0)
  (poke16 anim_frame 0)
  (init-pipe))

; =============================================================================
; Bird Physics
; =============================================================================

(defn update-bird ()
  (let (keys (peek16 KEYS_PRESSED))
    ; Flap on A press
    (if (!= (& keys KEY_A) 0)
        (do
          (set-flap-velocity)
          (sfx-flap))
        0)

    ; Physics
    (add-gravity)
    (clamp-velocity)
    (apply-velocity)

    ; Check boundaries
    (let (y-hi (peek16 bird_y_hi))
      ; Hit ceiling (wrapped negative)
      (if (>= y-hi 128)
          (do
            (poke16 bird_y_hi AREA_TOP)
            (poke16 bird_y_lo 0)
            (poke16 game_state STATE_DEAD)
            (sfx-die))
          ; Hit floor
          (if (> y-hi (- AREA_BOTTOM 8))
              (do
                (poke16 bird_y_hi (- AREA_BOTTOM 8))
                (poke16 bird_y_lo 0)
                (poke16 game_state STATE_DEAD)
                (sfx-die))
              0)))

    ; Update animation (based on velocity)
    (let (v-hi (peek16 bird_vel_hi))
      (if (>= v-hi 128)
          (poke16 anim_frame 2)       ; Going up - wings down
          (if (> v-hi 2)
              (poke16 anim_frame 0)   ; Falling - wings up
              (poke16 anim_frame 1)))))) ; Neutral - wings mid

; =============================================================================
; Pipe Logic
; =============================================================================

(defn update-pipe1 ()
  (let (x (peek16 pipe1_x)
        gap-y (peek16 pipe1_gap_y)
        passed (peek16 pipe1_passed))

    ; Move left
    (if (>= x PIPE_SPEED)
        (set x (- x PIPE_SPEED))
        ; Reset pipe - spawn ahead
        (let (seed (read-frame)
              new-gap (+ GAP_MIN (mod-by seed GAP_RANGE)))
          (set x (+ x (+ PIPE_SPACING PIPE_SPACING)))
          (set gap-y new-gap)
          (set passed 0)))

    ; Scoring
    (if (= passed 0)
        (if (< x BIRD_X)
            (do
              (set passed 1)
              (poke16 score (inc (peek16 score)))
              (sfx-score))
            0)
        0)

    (poke16 pipe1_x x)
    (poke16 pipe1_gap_y gap-y)
    (poke16 pipe1_passed passed)))

(defn update-pipe2 ()
  (let (x (peek16 pipe2_x)
        gap-y (peek16 pipe2_gap_y)
        passed (peek16 pipe2_passed))

    ; Move left
    (if (>= x PIPE_SPEED)
        (set x (- x PIPE_SPEED))
        ; Reset pipe - spawn ahead
        (let (seed (read-frame)
              new-gap (+ GAP_MIN (mod-by seed GAP_RANGE)))
          (set x (+ x (+ PIPE_SPACING PIPE_SPACING)))
          (set gap-y new-gap)
          (set passed 0)))

    ; Scoring
    (if (= passed 0)
        (if (< x BIRD_X)
            (do
              (set passed 1)
              (poke16 score (inc (peek16 score)))
              (sfx-score))
            0)
        0)

    (poke16 pipe2_x x)
    (poke16 pipe2_gap_y gap-y)
    (poke16 pipe2_passed passed)))

(defn update-pipes ()
  (update-pipe1)
  (update-pipe2))

; =============================================================================
; Collision
; =============================================================================

(defn check-collision ()
  (let (by (peek16 bird_y_hi)
        half (>> PIPE_GAP 1)
        hit 0)

    ; Check pipe 1
    (let (px (peek16 pipe1_x)
          gap-y (peek16 pipe1_gap_y)
          gap-top (- gap-y half)
          gap-bot (+ gap-y half))
      (if (< px 128)
          (if (< px (+ BIRD_X 6))
              (if (> (+ px PIPE_WIDTH) BIRD_X)
                  (if (< by gap-top)
                      (set hit 1)
                      (if (> (+ by 6) gap-bot)
                          (set hit 1)
                          0))
                  0)
              0)
          0))

    ; Check pipe 2
    (let (px (peek16 pipe2_x)
          gap-y (peek16 pipe2_gap_y)
          gap-top (- gap-y half)
          gap-bot (+ gap-y half))
      (if (< px 128)
          (if (< px (+ BIRD_X 6))
              (if (> (+ px PIPE_WIDTH) BIRD_X)
                  (if (< by gap-top)
                      (set hit 1)
                      (if (> (+ by 6) gap-bot)
                          (set hit 1)
                          0))
                  0)
              0)
          0))

    (if (!= hit 0)
        (do
          (poke16 game_state STATE_DEAD)
          (sfx-die))
        0)))

; =============================================================================
; Rendering
; =============================================================================

(defn render-bird ()
  (let (y (peek16 bird_y_hi)
        anim (peek16 anim_frame)
        tile TILE_BIRD_MID)
    (if (= anim 0)
        (set tile TILE_BIRD_UP)
        (if (= anim 2)
            (set tile TILE_BIRD_DOWN)
            (set tile TILE_BIRD_MID)))
    (draw-spr 0 y BIRD_X tile)))

(defn render-pipe1 ()
  (let (px (peek16 pipe1_x)
        gap-y (peek16 pipe1_gap_y)
        half (>> PIPE_GAP 1)
        gap-top (- gap-y half)
        gap-bot (+ gap-y half))

    (if (< px 138)
        (do
          ; Top pipe (behind background so sky/ground covers it)
          (draw-spr-attr 1 (- gap-top 8) px TILE_PIPE_CAP_DN SPRITE_BEHIND_BG)
          (draw-spr-attr 2 (- gap-top 16) px TILE_PIPE_BODY SPRITE_BEHIND_BG)
          (draw-spr-attr 3 (- gap-top 24) px TILE_PIPE_BODY SPRITE_BEHIND_BG)
          (draw-spr-attr 4 (- gap-top 32) px TILE_PIPE_BODY SPRITE_BEHIND_BG)
          (draw-spr-attr 5 (- gap-top 40) px TILE_PIPE_BODY SPRITE_BEHIND_BG)
          (draw-spr-attr 6 (- gap-top 48) px TILE_PIPE_BODY SPRITE_BEHIND_BG)
          (draw-spr-attr 7 (- gap-top 56) px TILE_PIPE_BODY SPRITE_BEHIND_BG)
          ; Bottom pipe (behind background so sky/ground covers it)
          (draw-spr-attr 8 gap-bot px TILE_PIPE_CAP_UP SPRITE_BEHIND_BG)
          (draw-spr-attr 9 (+ gap-bot 8) px TILE_PIPE_BODY SPRITE_BEHIND_BG)
          (draw-spr-attr 10 (+ gap-bot 16) px TILE_PIPE_BODY SPRITE_BEHIND_BG)
          (draw-spr-attr 11 (+ gap-bot 24) px TILE_PIPE_BODY SPRITE_BEHIND_BG)
          (draw-spr-attr 12 (+ gap-bot 32) px TILE_PIPE_BODY SPRITE_BEHIND_BG)
          (draw-spr-attr 13 (+ gap-bot 40) px TILE_PIPE_BODY SPRITE_BEHIND_BG)
          (draw-spr-attr 14 (+ gap-bot 48) px TILE_PIPE_BODY SPRITE_BEHIND_BG))
        ; Hide if off screen
        (let (i 1)
          (while (<= i 14)
            (draw-spr i 255 0 0)
            (set i (inc i)))))))

(defn render-pipe2 ()
  (let (px (peek16 pipe2_x)
        gap-y (peek16 pipe2_gap_y)
        half (>> PIPE_GAP 1)
        gap-top (- gap-y half)
        gap-bot (+ gap-y half))

    (if (< px 138)
        (do
          ; Top pipe (behind background so sky/ground covers it)
          (draw-spr-attr 15 (- gap-top 8) px TILE_PIPE_CAP_DN SPRITE_BEHIND_BG)
          (draw-spr-attr 16 (- gap-top 16) px TILE_PIPE_BODY SPRITE_BEHIND_BG)
          (draw-spr-attr 17 (- gap-top 24) px TILE_PIPE_BODY SPRITE_BEHIND_BG)
          (draw-spr-attr 18 (- gap-top 32) px TILE_PIPE_BODY SPRITE_BEHIND_BG)
          (draw-spr-attr 19 (- gap-top 40) px TILE_PIPE_BODY SPRITE_BEHIND_BG)
          (draw-spr-attr 20 (- gap-top 48) px TILE_PIPE_BODY SPRITE_BEHIND_BG)
          (draw-spr-attr 21 (- gap-top 56) px TILE_PIPE_BODY SPRITE_BEHIND_BG)
          ; Bottom pipe (behind background so sky/ground covers it)
          (draw-spr-attr 22 gap-bot px TILE_PIPE_CAP_UP SPRITE_BEHIND_BG)
          (draw-spr-attr 23 (+ gap-bot 8) px TILE_PIPE_BODY SPRITE_BEHIND_BG)
          (draw-spr-attr 24 (+ gap-bot 16) px TILE_PIPE_BODY SPRITE_BEHIND_BG)
          (draw-spr-attr 25 (+ gap-bot 24) px TILE_PIPE_BODY SPRITE_BEHIND_BG)
          (draw-spr-attr 26 (+ gap-bot 32) px TILE_PIPE_BODY SPRITE_BEHIND_BG)
          (draw-spr-attr 27 (+ gap-bot 40) px TILE_PIPE_BODY SPRITE_BEHIND_BG)
          (draw-spr-attr 28 (+ gap-bot 48) px TILE_PIPE_BODY SPRITE_BEHIND_BG))
        ; Hide if off screen
        (let (i 15)
          (while (<= i 28)
            (draw-spr i 255 0 0)
            (set i (inc i)))))))

(defn render-pipes ()
  (render-pipe1)
  (render-pipe2))

; Boundaries are now rendered via tilemap (set once at init)
; No per-frame sprite rendering needed

; Render score as 2 digits on top right (sprites 29-30)
(defn render-score ()
  (let (s (peek16 score)
        tens 0
        ones s)
    ; Calculate tens digit (s / 10)
    (while (>= ones 10)
      (set tens (inc tens))
      (set ones (- ones 10)))
    ; Draw tens digit (sprite 29) - hide if zero
    (if (> tens 0)
        (draw-spr 29 SCORE_Y (- SCORE_X 8) (+ TILE_DIGIT_0 tens))
        (draw-spr 29 255 0 0))
    ; Draw ones digit (sprite 30)
    (draw-spr 30 SCORE_Y SCORE_X (+ TILE_DIGIT_0 ones))))

(defn render-all ()
  (render-bird)
  (render-pipes)
  (render-score)
  (render))

; =============================================================================
; Main
; =============================================================================

(defn main ()
  ; One-time init
  (if (!= (peek16 initialized) 0xAA)
      (do
        (apu-init)
        (init-tilemap)
        (init-game)
        (poke16 initialized 0xAA))
      0)

  ; Game loop
  (while 1
    (wait-frame)

    (if (= (peek16 game_state) STATE_DEAD)
        ; Game over
        (if (!= (& (peek16 KEYS_PRESSED) KEY_START) 0)
            (init-game)
            0)
        ; Playing
        (do
          (update-bird)
          (if (= (peek16 game_state) STATE_PLAYING)
              (do
                (update-pipes)
                (check-collision))
              0)))

    (render-all)))

; System
(data initialized (db 0))
(data last_frame (db 0))

; Game state
(data game_state (db 0))
(data score (db 0))

; Bird position (8.8 fixed-point)
(data bird_y_hi (db 0))
(data bird_y_lo (db 0))

; Bird velocity (8.8 fixed-point)
(data bird_vel_hi (db 0))
(data bird_vel_lo (db 0))

; Pipe 1
(data pipe1_x (db 0))
(data pipe1_gap_y (db 0))
(data pipe1_passed (db 0))

; Pipe 2
(data pipe2_x (db 0))
(data pipe2_gap_y (db 0))
(data pipe2_passed (db 0))

; Animation
(data anim_frame (db 0))
