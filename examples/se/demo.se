; Bouncing Sprites Demo - 32 PPU Sprites
;
; Demonstrates:
; - PPU tile-based rendering with tileset
; - Hardware sprites via OAM (32 bouncing sprites)
; - Frame-synced animation at 60 FPS
;
; BUILD:
;   make examples-se
;   ./build/tiny16-emu build/demo_se.tiny16

(require (core sprite tilemap ppu))
(import "../examples/includes/tileset.inc")

(def SPRITE_COUNT 32)
(def BOUNDARY 120)
(def MIN_POSITION 10)
(def MODULO_RANGE 110)
(def VELOCITY_BASE 1)
(def TILE_SPRITE 99)

(defrecord sprite-info (x y vel-x vel-y))

(var sprites (array 32 (sprite-info 0 0 0 0)))

; Initialize one sprite with varied position and velocity
(defn init-one-sprite (i seed)
  (let (x (+ (% (+ seed (* i 7)) MODULO_RANGE) MIN_POSITION)
        y (+ (% (+ seed (* i 11)) MODULO_RANGE) MIN_POSITION)
        vel-x (+ VELOCITY_BASE (& (+ seed i) 1))
        vel-y (+ VELOCITY_BASE (& (+ seed (* i 3)) 1)))
    (set! (:x (nth sprites i)) x)
    (set! (:y (nth sprites i)) y)
    (set! (:vel-x (nth sprites i)) vel-x)
    (set! (:vel-y (nth sprites i)) vel-y)))

(defn init-sprites ()
  (sprite/hide-all)
  (tilemap/clear-all)
  (let (seed (core/read-frame))
    (for (i (range 0 SPRITE_COUNT))
      (init-one-sprite i seed))))

; Update one sprite position and handle bouncing
(defn update-one-sprite (i)
  (let (x (:x (nth sprites i))
        y (:y (nth sprites i))
        vx (:vel-x (nth sprites i))
        vy (:vel-y (nth sprites i)))

    ; Update position
    (set! x (+ x vx))
    (set! y (+ y vy))

    ; Bounce on boundaries
    (when (| (>= x BOUNDARY) (= x 0))
      (set! vx (- 0 vx)))
    (when (| (>= y BOUNDARY) (= y 0))
      (set! vy (- 0 vy)))

    ; Store updated values
    (set! (:x (nth sprites i)) x)
    (set! (:y (nth sprites i)) y)
    (set! (:vel-x (nth sprites i)) vx)
    (set! (:vel-y (nth sprites i)) vy)))

; Copy sprite data to OAM for rendering
(defn render-one-sprite (i)
  (let (x (:x (nth sprites i))
        y (:y (nth sprites i)))
    (sprite/draw i y x TILE_SPRITE)))

(defn update-sprites ()
  (for (i (range 0 SPRITE_COUNT))
    (update-one-sprite i)))

(defn render-sprites ()
  (for (i (range 0 SPRITE_COUNT))
    (render-one-sprite i)))

(defn main ()
  (init-sprites)

  (while 1
    (core/wait-frame)
    (update-sprites)
    (render-sprites)
    (ppu/render-all)))
