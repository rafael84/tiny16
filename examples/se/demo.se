; Bouncing Sprites Demo - 32 PPU Sprites
;
; tiny16se rewrite of demo.asm demonstrating:
; - PPU tile-based rendering with tileset
; - Hardware sprites via OAM (32 bouncing sprites)
; - Frame-synced animation at 60 FPS
;
; BUILD:
;   cd project_root
;   make examples-se  (or from project root:)
;   ./build/tiny16-sec examples/se/demo.se build/demo_se.asm
;   ./build/tiny16-asm build/demo_se.asm build/demo_se.tiny16
;   ./build/tiny16-emu build/demo_se.tiny16

; Include tileset data
(include "../examples/includes/tileset.inc")

; =============================================================================
; Constants - Memory Map
; =============================================================================

(def TILE_DATA_ADDR     0x5000)
(def TILEMAP_ADDR       0x7000)
(def OAM_ADDR           0x7800)
(def PALETTE_ADDR       0x7900)

; NOTE: Data labels (initialized, last_frame, bounce_flag, sprite_data)
; are auto-resolved by the compiler to their addresses
(def OAM_HI             (hi OAM_ADDR))
(def OAM_LO             (lo OAM_ADDR))
(def TILEMAP_HI         (hi TILEMAP_ADDR))
(def TILEMAP_LO         (lo TILEMAP_ADDR))

; =============================================================================
; Constants - MMIO/PPU
; =============================================================================

(def MMIO_BASE          0xBF00)
(def FRAME_COUNT_ADDR   (+ MMIO_BASE 0x22))
(def PPU_CTRL_ADDR      (+ MMIO_BASE 0x30))

; PPU_CTRL_BG_AND_SPRITES = 0x83 (Enable BG + Sprites + Render)
(def PPU_CTRL_BG_AND_SPRITES 0x83)

; =============================================================================
; Constants - Game Parameters
; =============================================================================

(def SPRITE_COUNT       32)
(def SPRITE_SIZE        4)
(def SPRITE_DATA_SIZE   128)
(def BOUNDARY           120)
(def MIN_POSITION       10)
(def MODULO_RANGE       110)
(def VELOCITY_BASE      1)
(def INITIALIZED_FLAG   0xAA)

(def TILE_SPRITE        68)
(def TILE_BACKGROUND    0)
(def SPRITE_ATTR_NONE   0x00)

; =============================================================================
; Helper Functions
; =============================================================================

(defn read-frame-count ()
  (peek16 FRAME_COUNT_ADDR))

(defn wait-frame ()
  (let (last (peek16 last_frame)
        current (read-frame-count))
    (while (= current last)
      (set current (read-frame-count)))
    (poke16 last_frame current)
    0))

(defn render-frame ()
  (poke16 PPU_CTRL_ADDR PPU_CTRL_BG_AND_SPRITES)
  0)

(defn mod-by (value divisor)
  (let (result value)
    (while (>= result divisor)
      (set result (- result divisor)))
    result))

; Calculate sprite data address low byte: (lo sprite_data) + (index * 4)
(defn sprite-data-lo (index)
  (+ (lo sprite_data) (<< index 2)))

; Calculate OAM address low byte: OAM_LO + (index * 4)
(defn oam-lo (index)
  (+ OAM_LO (<< index 2)))

; =============================================================================
; HIDE_ALL_SPRITES - Set Y=0xFF for all 64 OAM entries
; =============================================================================

(defn hide-one-sprite (i)
  (let (lo (+ OAM_LO (<< i 2)))
    (poke OAM_HI lo 0xFF)
    (poke OAM_HI (+ lo 1) 0)
    (poke OAM_HI (+ lo 2) 0)
    (poke OAM_HI (+ lo 3) 0)
    0))

(defn hide-all-sprites ()
  (let (i 0)
    (while (< i 64)
      (hide-one-sprite i)
      (set i (inc i)))
    0))

; =============================================================================
; FILL_TILEMAP - Fill 32x32 tilemap with background tile
; =============================================================================

(defn fill-tilemap ()
  (let (addr-hi TILEMAP_HI
        addr-lo TILEMAP_LO
        count 0)
    ; Fill 1024 tilemap entries (2 bytes each = 2048 bytes)
    ; Use a simple count that goes 0..255, 0..255, 0..255, 0..255 (4 times)
    ; and increment addr-hi each time addr-lo wraps
    (while (< addr-hi (+ TILEMAP_HI 8))
      (set count 0)
      (while (< count 128)
        ; Write tile index
        (poke addr-hi addr-lo TILE_BACKGROUND)
        (set addr-lo (inc addr-lo))
        ; Write attribute
        (poke addr-hi addr-lo 0)
        (set addr-lo (inc addr-lo))
        (set count (inc count)))
      ; Move to next 256-byte page
      (set addr-hi (inc addr-hi)))
    0))

; =============================================================================
; INIT_SPRITES - Initialize 32 sprites with varied positions and velocities
; =============================================================================

; Helper to compute i*7
(defn mul7 (n)
  (+ (<< n 2) (+ (<< n 1) n)))

; Helper to compute i*11
(defn mul11 (n)
  (+ (<< n 3) (+ (<< n 1) n)))

; Helper to compute i*3
(defn mul3 (n)
  (+ (<< n 1) n))

; Store sprite at index with computed values
(defn init-one-sprite (i seed)
  (let (i7 (mul7 i)
        i11 (mul11 i)
        i3 (mul3 i)
        base-x (+ seed i7)
        base-y (+ seed i11)
        x (+ (mod-by (+ base-x (<< base-x 1)) MODULO_RANGE) MIN_POSITION)
        y (+ (mod-by (<< base-y 1) MODULO_RANGE) MIN_POSITION)
        vel-x (+ VELOCITY_BASE (& (+ seed i) 1))
        vel-y (+ VELOCITY_BASE (& (+ seed i3) 1))
        lo (sprite-data-lo i))
    (poke (hi sprite_data) lo x)
    (poke (hi sprite_data) (+ lo 1) y)
    (poke (hi sprite_data) (+ lo 2) vel-x)
    (poke (hi sprite_data) (+ lo 3) vel-y)
    0))

(defn init-sprites ()
  (hide-all-sprites)
  (fill-tilemap)
  (let (seed (read-frame-count)
        i 0)
    (while (< i SPRITE_COUNT)
      (init-one-sprite i seed)
      (set i (inc i)))
    (poke16 initialized INITIALIZED_FLAG)
    0))

; =============================================================================
; UPDATE_ALL_OAM - Copy sprite positions to OAM
; =============================================================================

(defn update-one-oam (i)
  (let (data-lo (sprite-data-lo i)
        x (peek (hi sprite_data) data-lo)
        y (peek (hi sprite_data) (+ data-lo 1))
        oam (oam-lo i))
    ; OAM format: Y, X, tile, attr
    (poke OAM_HI oam y)
    (poke OAM_HI (+ oam 1) x)
    (poke OAM_HI (+ oam 2) TILE_SPRITE)
    (poke OAM_HI (+ oam 3) SPRITE_ATTR_NONE)
    0))

(defn update-all-oam ()
  (let (i 0)
    (while (< i SPRITE_COUNT)
      (update-one-oam i)
      (set i (inc i)))
    0))

; =============================================================================
; UPDATE_ALL_POSITIONS - Update positions with bouncing
; =============================================================================

(defn update-one-position (i)
  (let (lo (sprite-data-lo i)
        x (peek (hi sprite_data) lo)
        y (peek (hi sprite_data) (+ lo 1))
        vel-x (peek (hi sprite_data) (+ lo 2))
        vel-y (peek (hi sprite_data) (+ lo 3)))
    ; Update X: vel-x = 0 means moving left, > 0 means moving right
    (if (= vel-x 0)
        ; Moving left
        (if (< x VELOCITY_BASE)
            (do
              (set x 0)
              (set vel-x VELOCITY_BASE)
              (poke16 bounce_flag 1))
            (set x (- x VELOCITY_BASE)))
        ; Moving right
        (do
          (set x (+ x vel-x))
          (if (>= x BOUNDARY)
              (do
                (set x BOUNDARY)
                (set vel-x 0)
                (poke16 bounce_flag 1))
              0)))
    ; Update Y: vel-y = 0 means moving up, > 0 means moving down
    (if (= vel-y 0)
        ; Moving up
        (if (< y VELOCITY_BASE)
            (do
              (set y 0)
              (set vel-y VELOCITY_BASE)
              (poke16 bounce_flag 1))
            (set y (- y VELOCITY_BASE)))
        ; Moving down
        (do
          (set y (+ y vel-y))
          (if (>= y BOUNDARY)
              (do
                (set y BOUNDARY)
                (set vel-y 0)
                (poke16 bounce_flag 1))
              0)))
    ; Save updated values
    (poke (hi sprite_data) lo x)
    (poke (hi sprite_data) (+ lo 1) y)
    (poke (hi sprite_data) (+ lo 2) vel-x)
    (poke (hi sprite_data) (+ lo 3) vel-y)
    0))

(defn update-all-positions ()
  ; Clear bounce flag
  (poke16 bounce_flag 0)
  (let (i 0)
    (while (< i SPRITE_COUNT)
      (update-one-position i)
      (set i (inc i)))
    0))

; =============================================================================
; Main Entry Point
; =============================================================================

(defn main ()
  ; Check if already initialized
  (if (!= (peek16 initialized) INITIALIZED_FLAG)
      (do
        (init-sprites)
        (update-all-oam)
        (render-frame))
      0)
  ; Main loop
  (while 1
    (wait-frame)
    (update-all-oam)
    (update-all-positions)
    (render-frame))
  0)

; =============================================================================
; DATA SECTION - Auto-placed at 0x4000 (VM-defined data section start)
; =============================================================================

(data initialized (db 0))
(data last_frame (db 0))
(data bounce_flag (db 0))
(data padding (repeat 13 (db 0)))  ; Align sprite_data to offset 16
(data sprite_data (repeat 128 (db 0)))
