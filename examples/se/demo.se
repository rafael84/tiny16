; Bouncing Sprites Demo - 32 PPU Sprites
;
; Demonstrates:
; - PPU tile-based rendering with tileset
; - Hardware sprites via OAM (32 bouncing sprites)
; - Frame-synced animation at 60 FPS
;
; BUILD:
;   make examples-se
;   ./build/tiny16-emu build/demo_se.tiny16

(require (core sprite tilemap math ppu))
(import "../examples/includes/tileset.inc")

(def SPRITE_COUNT 32)
(def SPRITE_DATA_SIZE 128)
(def BOUNDARY 120)
(def MIN_POSITION 10)
(def MODULO_RANGE 110)
(def VELOCITY_BASE 1)
(def INIT_FLAG 0xAA)
(def TILE_SPRITE 99)

; Sprite data structure (4 bytes per sprite): x, y, vel-x, vel-y
(defn sprite-data-addr (index offset)
  (+ (lo sprite_data) (+ (* index 4) offset)))

; Initialize one sprite with varied position and velocity
(defn init-one-sprite (i seed)
  (let (x (+ (math/mod-by (+ seed (* i 7)) MODULO_RANGE) MIN_POSITION)
        y (+ (math/mod-by (+ seed (* i 11)) MODULO_RANGE) MIN_POSITION)
        vel-x (+ VELOCITY_BASE (& (+ seed i) 1))
        vel-y (+ VELOCITY_BASE (& (+ seed (* i 3)) 1)))
    (poke (hi sprite_data) (sprite-data-addr i 0) x)
    (poke (hi sprite_data) (sprite-data-addr i 1) y)
    (poke (hi sprite_data) (sprite-data-addr i 2) vel-x)
    (poke (hi sprite_data) (sprite-data-addr i 3) vel-y)))

(defn init-sprites ()
  (sprite/hide-all)
  (tilemap/clear-all)
  (let (seed (core/read-frame)
        i 0)
    (while (< i SPRITE_COUNT)
      (init-one-sprite i seed)
      (set i (inc i)))))

; Update one sprite position and handle bouncing
(defn update-one-sprite (i)
  (let (data-hi (hi sprite_data)
        x (peek data-hi (sprite-data-addr i 0))
        y (peek data-hi (sprite-data-addr i 1))
        vx (peek data-hi (sprite-data-addr i 2))
        vy (peek data-hi (sprite-data-addr i 3)))

    ; Update position
    (set x (+ x vx))
    (set y (+ y vy))

    ; Bounce on boundaries
    (if (| (>= x BOUNDARY) (= x 0))
        (set vx (- 0 vx))
        0)
    (if (| (>= y BOUNDARY) (= y 0))
        (set vy (- 0 vy))
        0)

    ; Store updated values
    (poke data-hi (sprite-data-addr i 0) x)
    (poke data-hi (sprite-data-addr i 1) y)
    (poke data-hi (sprite-data-addr i 2) vx)
    (poke data-hi (sprite-data-addr i 3) vy)))

; Copy sprite data to OAM for rendering
(defn render-one-sprite (i)
  (let (data-hi (hi sprite_data)
        x (peek data-hi (sprite-data-addr i 0))
        y (peek data-hi (sprite-data-addr i 1)))
    (sprite/draw i y x TILE_SPRITE)))

(defn update-sprites ()
  (let (i 0)
    (while (< i SPRITE_COUNT)
      (update-one-sprite i)
      (set i (inc i)))))

(defn render-sprites ()
  (let (i 0)
    (while (< i SPRITE_COUNT)
      (render-one-sprite i)
      (set i (inc i)))))

(defn main ()
  (init-sprites)

  (while 1
    (core/wait-frame)
    (update-sprites)
    (render-sprites)
    (ppu/render-all)))

(data sprite_data (repeat 32 (db 0 0 0 0)))
