; Floppy - Side-scrolling arcade game
;
; Gameplay:
; - Press A to start the game
; - Press A to flap and fly upward
; - Avoid the pipes (top and bottom)
; - Bird dies if it hits pipes or boundaries
; - Press A to restart after game over
;
; Features:
; - 8.8 fixed-point subpixel physics using stdlib
; - Animated bird sprite
; - Visual boundaries
; - Sound effects
;
; BUILD:
;   make examples-se
;   ./build/tiny16-emu build/floppy_se.tiny16

(require (core sprite tilemap input apu ppu math))

(import "../examples/includes/tileset.inc")

; =============================================================================
; Game Constants
; =============================================================================

(def KEY_A              0x04)
(def SPRITE_BEHIND_BG   0x20)

; Game states
(def STATE_WAITING      0)
(def STATE_PLAYING      1)
(def STATE_DEAD         2)
(def RESTART_DELAY      45)

; Text display
(def TEXT_ROW1          5)
(def TEXT_ROW2          6)
(def TEXT_COL           4)
(def TEXT_MAX_LEN       9)

; Playable area
(def AREA_TOP           20)
(def AREA_BOTTOM        108)

; Bird
(def BIRD_X             24)
(def BIRD_START_Y       60)
(def BIRD_SIZE          6)

; Pipe
(def PIPE_GAP           34)
(def PIPE_WIDTH         8)
(def PIPE_SPEED         1)
(def PIPE_SPAWN_X       136)
(def PIPE_SPACING       70)
(def GAP_MIN            38)
(def GAP_RANGE          50)
(def PIPE_OFF_X         0)
(def PIPE_OFF_GAP_Y     1)
(def PIPE_OFF_PASSED    2)

; Physics (8.8 fixed-point)
(def GRAVITY_HI         0)
(def GRAVITY_LO         70)
(def FLAP_VEL_HI        (- 256 3))
(def FLAP_VEL_LO        0)
(def MAX_FALL_HI        4)
(def MAX_FALL_LO        0)

; Tiles
(def TILE_BIRD_UP       41)
(def TILE_BIRD_MID      40)
(def TILE_BIRD_DOWN     42)
(def TILE_PIPE_CAP_UP   39)
(def TILE_PIPE_BODY     55)
(def TILE_PIPE_CAP_DN   71)
(def TILE_SKY_TOP       2)
(def TILE_SKY_BOT       1)
(def TILE_GROUND_TOP    81)
(def TILE_GROUND_MID    97)
(def TILE_GROUND_BOT    113)
(def TILE_DIGIT_0       144)
(def TILE_BUTTON_A      193)

; Display
(def SCORE_X            112)
(def SCORE_Y            4)
(def SPR_BIRD           0)
(def SPR_PIPE1_BASE     1)
(def SPR_PIPE2_BASE     15)
(def SPR_SCORE_TENS     29)
(def SPR_SCORE_ONES     30)
(def PIPE_SPRITES       14)

; Constants
(def TILE_SIZE          8)
(def SCREEN_WIDTH       128)
(def SCREEN_TILES       16)
(def SPRITE_HIDDEN_Y    255)
(def NEGATIVE_THRESHOLD 128)
(def PIPE_VISIBLE_MAX   138)
(def ANIM_GOING_UP      2)
(def ANIM_FALLING       0)
(def ANIM_NEUTRAL       1)
(def VEL_NEUTRAL_MAX    2)
(def INIT_FLAG          0xAA)
(def RANDOM_OFFSET      37)

; Tilemap rows
(def TILE_ROW_SKY1      0)
(def TILE_ROW_SKY2      1)
(def TILE_ROW_SKY3      2)
(def TILE_ROW_GROUND1   13)
(def TILE_ROW_GROUND2   14)
(def TILE_ROW_GROUND3   15)

; =============================================================================
; Tilemap Init
; =============================================================================

(defn init-tilemap ()
  (tilemap/fill-row TILE_ROW_SKY1 TILE_SKY_TOP)
  (tilemap/fill-row TILE_ROW_SKY2 TILE_SKY_TOP)
  (tilemap/fill-row TILE_ROW_SKY3 TILE_SKY_BOT)
  (tilemap/fill-row TILE_ROW_GROUND1 TILE_GROUND_TOP)
  (tilemap/fill-row TILE_ROW_GROUND2 TILE_GROUND_MID)
  (tilemap/fill-row TILE_ROW_GROUND3 TILE_GROUND_BOT))

; =============================================================================
; Text Display
; =============================================================================

(defn clear-text ()
  (let (x 0)
    (while (< x TEXT_MAX_LEN)
      (tilemap/put (+ TEXT_COL x) TEXT_ROW1 0)
      (tilemap/put (+ TEXT_COL x) TEXT_ROW2 0)
      (set x (inc x)))))

(defn show-press-a ()
  (tilemap/text (+ TEXT_COL 1) TEXT_ROW1 (hi str_press_a) (lo str_press_a)))

(defn show-game-over ()
  (tilemap/text TEXT_COL TEXT_ROW1 (hi str_game_over) (lo str_game_over))
  (tilemap/text (+ TEXT_COL 1) TEXT_ROW2 (hi str_press_a) (lo str_press_a)))

; =============================================================================
; Sound Effects
; =============================================================================

(defn sfx-flap ()
  (apu/ch0-set-envelope 1 1 8 1)
  (apu/ch0-play-note 0xC8 0x07 0x12 3))

(defn sfx-die ()
  (apu/ch3-set-envelope 1 5 0 4)
  (apu/ch3-play-noise 9 14 18))

(defn sfx-score ()
  (apu/ch0-set-envelope 1 1 6 1)
  (apu/ch0-play-note 0xD0 0x07 0x2C 4))

; =============================================================================
; Fixed-Point Physics
; =============================================================================

(defn add-gravity ()
  (let (v-lo (peek16 bird_vel_lo)
        new-lo (+ v-lo GRAVITY_LO)
        carry (if (< new-lo v-lo) 1 0)
        v-hi (peek16 bird_vel_hi)
        new-hi (+ v-hi (+ GRAVITY_HI carry)))
    (poke16 bird_vel_hi new-hi)
    (poke16 bird_vel_lo new-lo)))

(defn apply-velocity ()
  (let (y-lo (peek16 bird_y_lo)
        v-lo (peek16 bird_vel_lo)
        new-lo (+ y-lo v-lo)
        carry (if (< new-lo y-lo) 1 0)
        y-hi (peek16 bird_y_hi)
        v-hi (peek16 bird_vel_hi)
        new-hi (+ y-hi (+ v-hi carry)))
    (poke16 bird_y_hi new-hi)
    (poke16 bird_y_lo new-lo)))

(defn set-flap-velocity ()
  (poke16 bird_vel_hi FLAP_VEL_HI)
  (poke16 bird_vel_lo FLAP_VEL_LO))

(defn clamp-velocity ()
  (let (v-hi (peek16 bird_vel_hi))
    (if (< v-hi NEGATIVE_THRESHOLD)
        (if (> v-hi MAX_FALL_HI)
            (do
              (poke16 bird_vel_hi MAX_FALL_HI)
              (poke16 bird_vel_lo MAX_FALL_LO))
            0)
        0)))

; =============================================================================
; Game Init
; =============================================================================

(defn init-single-pipe (data-hi data-lo x gap-y)
  (poke data-hi (+ data-lo PIPE_OFF_X) x)
  (poke data-hi (+ data-lo PIPE_OFF_GAP_Y) gap-y)
  (poke data-hi (+ data-lo PIPE_OFF_PASSED) 0))

(defn init-pipe ()
  (let (seed (core/read-frame)
        gap1 (+ GAP_MIN (math/mod-by seed GAP_RANGE))
        gap2 (+ GAP_MIN (math/mod-by (+ seed RANDOM_OFFSET) GAP_RANGE)))
    (init-single-pipe (hi pipe1_data) (lo pipe1_data) PIPE_SPAWN_X gap1)
    (init-single-pipe (hi pipe2_data) (lo pipe2_data) (+ PIPE_SPAWN_X PIPE_SPACING) gap2)))

(defn init-game ()
  (sprite/hide-all)
  (poke16 bird_y_hi BIRD_START_Y)
  (poke16 bird_y_lo 0)
  (poke16 bird_vel_hi 0)
  (poke16 bird_vel_lo 0)
  (poke16 game_state STATE_WAITING)
  (poke16 score 0)
  (poke16 anim_frame 0)
  (init-pipe)
  (show-press-a))

; =============================================================================
; Bird Physics
; =============================================================================

(defn die ()
  (poke16 game_state STATE_DEAD)
  (poke16 dead_timer 0)
  (show-game-over)
  (sfx-die))

(defn start-game ()
  (clear-text)
  (poke16 game_state STATE_PLAYING))

(defn update-bird (keys)
  (if (!= (& keys KEY_A) 0)
      (do
        (set-flap-velocity)
        (sfx-flap))
      0)

  (add-gravity)
  (clamp-velocity)
  (apply-velocity)

  (let (y-hi (peek16 bird_y_hi))
    (if (>= y-hi NEGATIVE_THRESHOLD)
        (do
          (poke16 bird_y_hi AREA_TOP)
          (poke16 bird_y_lo 0)
          (die))
        (if (> y-hi (- AREA_BOTTOM TILE_SIZE))
            (do
              (poke16 bird_y_hi (- AREA_BOTTOM TILE_SIZE))
              (poke16 bird_y_lo 0)
              (die))
            0)))

  (let (v-hi (peek16 bird_vel_hi))
    (if (>= v-hi NEGATIVE_THRESHOLD)
        (poke16 anim_frame ANIM_GOING_UP)
        (if (> v-hi VEL_NEUTRAL_MAX)
            (poke16 anim_frame ANIM_FALLING)
            (poke16 anim_frame ANIM_NEUTRAL)))))

; =============================================================================
; Pipe Logic
; =============================================================================

(defn update-pipe (data-hi data-lo)
  (let (x (peek data-hi (+ data-lo PIPE_OFF_X))
        gap-y (peek data-hi (+ data-lo PIPE_OFF_GAP_Y))
        passed (peek data-hi (+ data-lo PIPE_OFF_PASSED)))

    (if (>= x PIPE_SPEED)
        (set x (- x PIPE_SPEED))
        (let (seed (core/read-frame)
              new-gap (+ GAP_MIN (math/mod-by seed GAP_RANGE)))
          (set x (+ x (+ PIPE_SPACING PIPE_SPACING)))
          (set gap-y new-gap)
          (set passed 0)))

    (if (= passed 0)
        (if (< x BIRD_X)
            (do
              (set passed 1)
              (poke16 score (inc (peek16 score)))
              (sfx-score))
            0)
        0)

    (poke data-hi (+ data-lo PIPE_OFF_X) x)
    (poke data-hi (+ data-lo PIPE_OFF_GAP_Y) gap-y)
    (poke data-hi (+ data-lo PIPE_OFF_PASSED) passed)))

(defn update-pipes ()
  (update-pipe (hi pipe1_data) (lo pipe1_data))
  (update-pipe (hi pipe2_data) (lo pipe2_data)))

; =============================================================================
; Collision
; =============================================================================

(defn check-pipe-hit (data-hi data-lo by half)
  (let (px (peek data-hi (+ data-lo PIPE_OFF_X))
        gap-y (peek data-hi (+ data-lo PIPE_OFF_GAP_Y))
        gap-top (- gap-y half)
        gap-bot (+ gap-y half))
    (if (< px SCREEN_WIDTH)
        (if (< px (+ BIRD_X BIRD_SIZE))
            (if (> (+ px PIPE_WIDTH) BIRD_X)
                (if (< by gap-top)
                    1
                    (if (> (+ by BIRD_SIZE) gap-bot)
                        1
                        0))
                0)
            0)
        0)))

(defn check-collision ()
  (let (by (peek16 bird_y_hi)
        half (>> PIPE_GAP 1)
        hit1 (check-pipe-hit (hi pipe1_data) (lo pipe1_data) by half)
        hit2 (check-pipe-hit (hi pipe2_data) (lo pipe2_data) by half))
    (if (!= (| hit1 hit2) 0)
        (die)
        0)))

; =============================================================================
; Rendering
; =============================================================================

(defn render-bird ()
  (let (y (peek16 bird_y_hi)
        anim (peek16 anim_frame)
        tile TILE_BIRD_MID)
    (if (= anim ANIM_FALLING)
        (set tile TILE_BIRD_UP)
        (if (= anim ANIM_GOING_UP)
            (set tile TILE_BIRD_DOWN)
            (set tile TILE_BIRD_MID)))
    (sprite/draw SPR_BIRD y BIRD_X tile)))

(defn render-pipe (data-hi data-lo base)
  (let (px (peek data-hi (+ data-lo PIPE_OFF_X))
        gap-y (peek data-hi (+ data-lo PIPE_OFF_GAP_Y))
        half (>> PIPE_GAP 1)
        gap-top (- gap-y half)
        gap-bot (+ gap-y half))

    (if (< px PIPE_VISIBLE_MAX)
        (do
          (sprite/draw-attr base (- gap-top TILE_SIZE) px TILE_PIPE_CAP_DN SPRITE_BEHIND_BG)
          (sprite/draw-attr (+ base 1) (- gap-top (* TILE_SIZE 2)) px TILE_PIPE_BODY SPRITE_BEHIND_BG)
          (sprite/draw-attr (+ base 2) (- gap-top (* TILE_SIZE 3)) px TILE_PIPE_BODY SPRITE_BEHIND_BG)
          (sprite/draw-attr (+ base 3) (- gap-top (* TILE_SIZE 4)) px TILE_PIPE_BODY SPRITE_BEHIND_BG)
          (sprite/draw-attr (+ base 4) (- gap-top (* TILE_SIZE 5)) px TILE_PIPE_BODY SPRITE_BEHIND_BG)
          (sprite/draw-attr (+ base 5) (- gap-top (* TILE_SIZE 6)) px TILE_PIPE_BODY SPRITE_BEHIND_BG)
          (sprite/draw-attr (+ base 6) (- gap-top (* TILE_SIZE 7)) px TILE_PIPE_BODY SPRITE_BEHIND_BG)
          (sprite/draw-attr (+ base 7) gap-bot px TILE_PIPE_CAP_UP SPRITE_BEHIND_BG)
          (sprite/draw-attr (+ base 8) (+ gap-bot TILE_SIZE) px TILE_PIPE_BODY SPRITE_BEHIND_BG)
          (sprite/draw-attr (+ base 9) (+ gap-bot (* TILE_SIZE 2)) px TILE_PIPE_BODY SPRITE_BEHIND_BG)
          (sprite/draw-attr (+ base 10) (+ gap-bot (* TILE_SIZE 3)) px TILE_PIPE_BODY SPRITE_BEHIND_BG)
          (sprite/draw-attr (+ base 11) (+ gap-bot (* TILE_SIZE 4)) px TILE_PIPE_BODY SPRITE_BEHIND_BG)
          (sprite/draw-attr (+ base 12) (+ gap-bot (* TILE_SIZE 5)) px TILE_PIPE_BODY SPRITE_BEHIND_BG)
          (sprite/draw-attr (+ base 13) (+ gap-bot (* TILE_SIZE 6)) px TILE_PIPE_BODY SPRITE_BEHIND_BG))
        (let (i 0)
          (while (< i PIPE_SPRITES)
            (sprite/draw (+ base i) SPRITE_HIDDEN_Y 0 0)
            (set i (inc i)))))))

(defn render-pipes ()
  (render-pipe (hi pipe1_data) (lo pipe1_data) SPR_PIPE1_BASE)
  (render-pipe (hi pipe2_data) (lo pipe2_data) SPR_PIPE2_BASE))

(defn render-score ()
  (let (s (peek16 score)
        tens 0
        ones s)
    (while (>= ones 10)
      (set tens (inc tens))
      (set ones (- ones 10)))
    (if (> tens 0)
        (sprite/draw SPR_SCORE_TENS SCORE_Y (- SCORE_X TILE_SIZE) (+ TILE_DIGIT_0 tens))
        (sprite/draw SPR_SCORE_TENS SPRITE_HIDDEN_Y 0 0))
    (sprite/draw SPR_SCORE_ONES SCORE_Y SCORE_X (+ TILE_DIGIT_0 ones))))

(defn render-game ()
  (render-bird)
  (render-pipes)
  (render-score)
  (ppu/render-all))

; =============================================================================
; Main
; =============================================================================

(defn main ()
  (if (!= (peek16 initialized) INIT_FLAG)
      (do
        (apu/init)
        (init-tilemap)
        (init-game)
        (poke16 initialized INIT_FLAG))
      0)

  (while 1
    (core/wait-frame)

    (let (state (peek16 game_state)
          pressed (input/keys-pressed))

      (if (= state STATE_WAITING)
          (if (!= (& pressed KEY_A) 0)
              (do
                (start-game)
                (set-flap-velocity)
                (sfx-flap))
              0)
          (if (= state STATE_DEAD)
              (let (timer (peek16 dead_timer))
                (if (< timer RESTART_DELAY)
                    (poke16 dead_timer (inc timer))
                    (if (!= (& pressed KEY_A) 0)
                        (do
                          (init-game)
                          (start-game)
                          (set-flap-velocity)
                          (sfx-flap))
                        0)))
              (do
                (update-bird pressed)
                (if (= (peek16 game_state) STATE_PLAYING)
                    (do
                      (update-pipes)
                      (check-collision))
                    0)))))

    (render-game)))

; =============================================================================
; Data
; =============================================================================

(data initialized (db 0))
(data game_state (db 0))
(data score (db 0))
(data dead_timer (db 0))

(data bird_y_hi (db 0))
(data bird_y_lo (db 0))
(data bird_vel_hi (db 0))
(data bird_vel_lo (db 0))

(data pipe1_data (db 0 0 0))
(data pipe2_data (db 0 0 0))

(data anim_frame (db 0))

(data str_press_a (db "PRESS " (- TILE_BUTTON_A 96) 0))
(data str_game_over (db "GAME OVER" 0))
