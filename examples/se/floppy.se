; Floppy - Side-scrolling arcade game
;
; Gameplay:
; - Press A to start the game
; - Press A to flap and fly upward
; - Avoid the pipes (top and bottom)
; - Bird dies if it hits pipes or boundaries
; - Press A to restart after game over
;
; Features:
; - 8.8 fixed-point subpixel physics (SEv2 native ^i16)
; - Direct 16-bit signed comparisons for physics
; - Animated bird sprite
; - Visual boundaries
; - Sound effects
;
; BUILD:
;   make examples-se
;   ./build/tiny16-emu build/floppy_se.tiny16

(require (core sprite tilemap input apu ppu math constants))

(import "../examples/includes/tileset.inc")

; =============================================================================
; Background / Tilemap
; =============================================================================

; Palette is provided by the tileset (tileset.inc includes ORG 0x9200 data)

(defn init-tilemap ()
  (tilemap/fill-row 0 2)    ; Sky top
  (tilemap/fill-row 1 2)    ; Sky top
  (tilemap/fill-row 2 1)    ; Sky bottom
  (tilemap/fill-row 13 81)  ; Ground top
  (tilemap/fill-row 14 97)  ; Ground mid
  (tilemap/fill-row 15 113)) ; Ground bottom

; =============================================================================
; Game State
; =============================================================================

(def RESTART_DELAY 45)

(var initialized false)
(var state :waiting)
(var score 0)
(var dead-timer 0)

(defn init-game ()
  (sprite/hide-all)
  (set! bird-y 60.0)
  (set! bird-vel 0)
  (set! state :waiting)
  (set! score 0)
  (set! anim-frame 0)
  (init-pipe)
  (show-press-a))

(defn start-game ()
  (clear-text)
  (set! state :playing)
  (apu/music-ch0-play (hi game_music) (lo game_music) 0 96 1))  ; 96 = MUSIC_LENGTH

(defn die ()
  (set! state :dead)
  (set! dead-timer 0)
  (apu/music-stop)
  (show-game-over)
  (sfx-die))

; =============================================================================
; Text / UI
; =============================================================================

(def TILE_BUTTON_A 193)

(data str_press_a (db "PRESS " (- TILE_BUTTON_A 96) 0))
(data str_game_over (db "GAME OVER" 0))

(defn clear-text ()
  (for (x (range 0 9))
    (tilemap/put (+ 4 x) 5 0)
    (tilemap/put (+ 4 x) 6 0)))

(defn show-press-a ()
  (tilemap/text 5 5 (hi str_press_a) (lo str_press_a)))

(defn show-game-over ()
  (tilemap/text 4 5 (hi str_game_over) (lo str_game_over))
  (tilemap/text 5 6 (hi str_press_a) (lo str_press_a)))

; =============================================================================
; Score Display
; =============================================================================

(def TILE_DIGIT_0 144)

(defn render-score ()
  (let (tens (/ score 10)
        ones (% score 10))
    (if (> tens 0)
        (sprite/draw 29 4 104 (+ TILE_DIGIT_0 tens))
        (sprite/draw 29 constants/SPRITE_HIDDEN_Y 0 0))
    (sprite/draw 30 4 112 (+ TILE_DIGIT_0 ones))))

; =============================================================================
; Bird (8.8 fixed-point physics using ^i16)
; =============================================================================

(def BIRD_X 24)
(def BIRD_SIZE 6)

; Physics — 8.8 fixed-point constants
(def GRAVITY 70)              ; ~0.27 px/frame² (raw 8.8 sub-pixel increment)
(def FLAP_VEL -3.0)           ; upward impulse
(def MAX_FALL_SPEED 4.0)      ; terminal velocity
(def ANIM_THRESHOLD 2.0)      ; velocity above which bird shows "falling" frame

; Boundary positions (8.8 fixed-point for direct 16-bit comparison)
(def CEILING_Y 20.0)
(def GROUND_Y  100.0)

; Tiles
(def TILE_BIRD_UP   41)
(def TILE_BIRD_MID  40)
(def TILE_BIRD_DOWN 42)

; Animation states
(def ANIM_FALLING  0)
(def ANIM_NEUTRAL  1)
(def ANIM_GOING_UP 2)

; Bird state — ^i16 for 8.8 fixed-point position and velocity
(var ^i16 bird-y 0)
(var ^i16 bird-vel 0)
(var anim-frame 0)

(defn update-bird ()
  ; Input
  (when (input/key-pressed constants/KEY_A)
    (set! bird-vel FLAP_VEL)
    (sfx-flap))

  ; Gravity
  (set! bird-vel (+ bird-vel GRAVITY))

  ; Clamp terminal velocity (signed: negative velocities pass through)
  (when (> bird-vel MAX_FALL_SPEED)
    (set! bird-vel MAX_FALL_SPEED))

  ; Apply velocity
  (set! bird-y (+ bird-y bird-vel))

  ; Boundary checks (16-bit signed)
  (when (< bird-y 0)
    (set! bird-y CEILING_Y)
    (die))
  (when (> bird-y GROUND_Y)
    (set! bird-y GROUND_Y)
    (die))

  ; Animation based on velocity (16-bit signed)
  (cond
    ((< bird-vel 0)              (set! anim-frame ANIM_GOING_UP))
    ((> bird-vel ANIM_THRESHOLD) (set! anim-frame ANIM_FALLING))
    (true                        (set! anim-frame ANIM_NEUTRAL))))

(defn render-bird ()
  (let (y (u8 bird-y)
        tile TILE_BIRD_MID)
    (cond
      ((= anim-frame ANIM_FALLING)  (set! tile TILE_BIRD_UP))
      ((= anim-frame ANIM_GOING_UP) (set! tile TILE_BIRD_DOWN)))
    (sprite/draw 0 y BIRD_X tile)))

; =============================================================================
; Pipes (defrecord + array + keyword accessors)
; =============================================================================

(def PIPE_GAP     34)
(def PIPE_WIDTH   8)
(def PIPE_SPEED   1)
(def PIPE_SPACING 70)
(def GAP_MIN      38)
(def GAP_RANGE    50)
(def GAP_MAX      88)        ; GAP_MIN + GAP_RANGE

; Tiles
(def TILE_PIPE_CAP_UP 39)
(def TILE_PIPE_BODY   55)
(def TILE_PIPE_CAP_DN 71)

(defrecord pipe (x gap-y passed))

(var pipes (array 2 (pipe 0 0 0)))

(def PIPE_SPAWN_X 136)
(def PIPE_SPR_BASE_0 1)

(defn init-one-pipe (i x gap-y)
  (set! (:x (nth pipes i)) x)
  (set! (:gap-y (nth pipes i)) gap-y)
  (set! (:passed (nth pipes i)) 0))

(defn init-pipe ()
  (let (gap1 (math/random-range GAP_MIN GAP_MAX)
        gap2 (+ GAP_MIN (% (+ gap1 37) GAP_RANGE)))
    (init-one-pipe 0 PIPE_SPAWN_X gap1)
    (init-one-pipe 1 206 gap2)))

(defn update-one-pipe (i)
  (let (x (:x (nth pipes i))
        gap-y (:gap-y (nth pipes i))
        passed (:passed (nth pipes i)))

    (if (>= x PIPE_SPEED)
        (set! x (- x PIPE_SPEED))
        (do
          (set! x (+ x (+ PIPE_SPACING PIPE_SPACING)))
          (set! gap-y (math/random-range GAP_MIN GAP_MAX))
          (set! passed 0)))

    (when (and (= passed 0) (< x BIRD_X))
      (set! passed 1)
      (core/inc! score)
      (sfx-score))

    (set! (:x (nth pipes i)) x)
    (set! (:gap-y (nth pipes i)) gap-y)
    (set! (:passed (nth pipes i)) passed)))

(defn update-pipes ()
  (for (i (range 0 2))
    (update-one-pipe i)))

(defn check-pipe-hit (i by half)
  (let (px (:x (nth pipes i))
        gap-y (:gap-y (nth pipes i))
        gap-top (- gap-y half)
        gap-bot (+ gap-y half))
    (if (< px 128)
        (if (< px (+ BIRD_X BIRD_SIZE))
            (if (> (+ px PIPE_WIDTH) BIRD_X)
                (if (< by gap-top)
                    1
                    (if (> (+ by BIRD_SIZE) gap-bot)
                        1
                        0))
                0)
            0)
        0)))

(defn check-collision ()
  (let (by (u8 bird-y)
        half (>> PIPE_GAP 1)
        hit1 (check-pipe-hit 0 by half)
        hit2 (check-pipe-hit 1 by half))
    (when (!= (| hit1 hit2) 0)
      (die))))

(defn render-one-pipe (i base)
  (let (px (:x (nth pipes i))
        gap-y (:gap-y (nth pipes i))
        half (>> PIPE_GAP 1)
        gap-top (- gap-y half)
        gap-bot (+ gap-y half))

    (if (< px 138)
        (do
          (sprite/draw-attr base (- gap-top 8) px TILE_PIPE_CAP_DN constants/SPRITE_BEHIND_BG)
          (sprite/draw-attr (+ base 1) (- gap-top 16) px TILE_PIPE_BODY constants/SPRITE_BEHIND_BG)
          (sprite/draw-attr (+ base 2) (- gap-top 24) px TILE_PIPE_BODY constants/SPRITE_BEHIND_BG)
          (sprite/draw-attr (+ base 3) (- gap-top 32) px TILE_PIPE_BODY constants/SPRITE_BEHIND_BG)
          (sprite/draw-attr (+ base 4) (- gap-top 40) px TILE_PIPE_BODY constants/SPRITE_BEHIND_BG)
          (sprite/draw-attr (+ base 5) (- gap-top 48) px TILE_PIPE_BODY constants/SPRITE_BEHIND_BG)
          (sprite/draw-attr (+ base 6) (- gap-top 56) px TILE_PIPE_BODY constants/SPRITE_BEHIND_BG)
          (sprite/draw-attr (+ base 7) gap-bot px TILE_PIPE_CAP_UP constants/SPRITE_BEHIND_BG)
          (sprite/draw-attr (+ base 8) (+ gap-bot 8) px TILE_PIPE_BODY constants/SPRITE_BEHIND_BG)
          (sprite/draw-attr (+ base 9) (+ gap-bot 16) px TILE_PIPE_BODY constants/SPRITE_BEHIND_BG)
          (sprite/draw-attr (+ base 10) (+ gap-bot 24) px TILE_PIPE_BODY constants/SPRITE_BEHIND_BG)
          (sprite/draw-attr (+ base 11) (+ gap-bot 32) px TILE_PIPE_BODY constants/SPRITE_BEHIND_BG)
          (sprite/draw-attr (+ base 12) (+ gap-bot 40) px TILE_PIPE_BODY constants/SPRITE_BEHIND_BG)
          (sprite/draw-attr (+ base 13) (+ gap-bot 48) px TILE_PIPE_BODY constants/SPRITE_BEHIND_BG))
        (for (j (range 0 14))
          (sprite/draw (+ base j) constants/SPRITE_HIDDEN_Y 0 0)))))

(defn render-pipes ()
  (for (i (range 0 2))
    (render-one-pipe i (+ PIPE_SPR_BASE_0 (* i 14)))))

; =============================================================================
; Sound Effects
; =============================================================================

(def SFX_FLAP  0)
(def SFX_DIE   1)
(def SFX_SCORE 2)

(defn sfx-flap ()
  (apu/sfx-play SFX_FLAP))

(defn sfx-die ()
  (apu/sfx-play SFX_DIE))

(defn sfx-score ()
  (apu/sfx-play SFX_SCORE))

; SFX Bank Table
; Format: channel, freq_lo, freq_hi|waveform, volume, env_ad, duration (6 bytes)
(data sfx_table
  ; ID 0: Flap (pulse, high pitch chirp)
  (db 0 0xC8 0x47 12 0x11 3)
  ; ID 1: Die (noise, harsh)
  (db 3 9 0x60 14 0x15 18)
  ; ID 2: Score (pulse, bright coin sound)
  (db 0 0xD0 0x47 10 0x11 4))

; =============================================================================
; Main Game Loop
; =============================================================================

(defn render-game ()
  (render-bird)
  (render-pipes)
  (render-score)
  (ppu/render-all))

(defn main ()
  (unless initialized
    (apu/init)
    (apu/sfx-init (hi sfx_table) (lo sfx_table) 3)
    (init-tilemap)
    (init-game)
    (set! initialized true))

  (while 1
    (core/wait-frame)

    (cond
      ((= state :waiting)
       (when (input/key-pressed constants/KEY_A)
         (start-game)
         (set! bird-vel FLAP_VEL)
         (sfx-flap)))
      ((= state :dead)
       (when (< dead-timer RESTART_DELAY)
         (core/inc! dead-timer))
       (when (>= dead-timer RESTART_DELAY)
         (when (input/key-pressed constants/KEY_A)
           (init-game)
           (start-game)
           (set! bird-vel FLAP_VEL)
           (sfx-flap))))
      ((= state :playing)
       (update-bird)
       (update-pipes)
       (check-collision)))

    (render-game)))

; =============================================================================
; Background Music Data
; =============================================================================
; Format: note, volume, duration, waveform (4 bytes per note)
; Upbeat arcade melody - 96 notes

(data game_music
  ; === Section A: Main Theme (32 notes) ===
  ; Bar 1-2: Opening hook
  (db apu/NOTE_C4  apu/DYN_PP apu/DUR_QUARTER       apu/WAVE_PULSE)
  (db apu/NOTE_C4  apu/DYN_PP apu/DUR_QUARTER       apu/WAVE_PULSE)
  (db apu/NOTE_REST 0         apu/DUR_QUARTER       apu/WAVE_PULSE)
  (db apu/NOTE_C4  apu/DYN_PP apu/DUR_QUARTER       apu/WAVE_PULSE)
  (db apu/NOTE_REST 0         apu/DUR_QUARTER       apu/WAVE_PULSE)
  (db apu/NOTE_A3  apu/DYN_PP apu/DUR_QUARTER       apu/WAVE_PULSE)
  (db apu/NOTE_C4  apu/DYN_PP apu/DUR_HALF          apu/WAVE_PULSE)
  (db apu/NOTE_G3  apu/DYN_PP apu/DUR_HALF          apu/WAVE_PULSE)
  ; Bar 3-4
  (db apu/NOTE_E3  apu/DYN_PP apu/DUR_QUARTER       apu/WAVE_PULSE)
  (db apu/NOTE_E3  apu/DYN_PP apu/DUR_QUARTER       apu/WAVE_PULSE)
  (db apu/NOTE_REST 0         apu/DUR_QUARTER       apu/WAVE_PULSE)
  (db apu/NOTE_E3  apu/DYN_PP apu/DUR_QUARTER       apu/WAVE_PULSE)
  (db apu/NOTE_REST 0         apu/DUR_QUARTER       apu/WAVE_PULSE)
  (db apu/NOTE_C3  apu/DYN_PP apu/DUR_QUARTER       apu/WAVE_PULSE)
  (db apu/NOTE_E3  apu/DYN_PP apu/DUR_HALF          apu/WAVE_PULSE)
  (db apu/NOTE_REST 0         apu/DUR_HALF          apu/WAVE_PULSE)
  ; Bar 5-6: Rising phrase
  (db apu/NOTE_C3  apu/DYN_PP apu/DUR_QUARTER       apu/WAVE_PULSE)
  (db apu/NOTE_D3  apu/DYN_PP apu/DUR_QUARTER       apu/WAVE_PULSE)
  (db apu/NOTE_E3  apu/DYN_PP apu/DUR_QUARTER       apu/WAVE_PULSE)
  (db apu/NOTE_F3  apu/DYN_PP apu/DUR_QUARTER       apu/WAVE_PULSE)
  (db apu/NOTE_G3  apu/DYN_PP apu/DUR_QUARTER       apu/WAVE_PULSE)
  (db apu/NOTE_A3  apu/DYN_PP apu/DUR_QUARTER       apu/WAVE_PULSE)
  (db apu/NOTE_B3  apu/DYN_PP apu/DUR_QUARTER       apu/WAVE_PULSE)
  (db apu/NOTE_C4  apu/DYN_PP apu/DUR_QUARTER       apu/WAVE_PULSE)
  ; Bar 7-8: Descending
  (db apu/NOTE_D4  apu/DYN_PP apu/DUR_DOTTED_QUARTER apu/WAVE_PULSE)
  (db apu/NOTE_C4  apu/DYN_PP apu/DUR_DOTTED_QUARTER apu/WAVE_PULSE)
  (db apu/NOTE_A3  apu/DYN_PP apu/DUR_DOTTED_QUARTER apu/WAVE_PULSE)
  (db apu/NOTE_G3  apu/DYN_PP apu/DUR_DOTTED_QUARTER apu/WAVE_PULSE)
  (db apu/NOTE_E3  apu/DYN_PP apu/DUR_HALF          apu/WAVE_PULSE)
  (db apu/NOTE_REST 0         apu/DUR_HALF          apu/WAVE_PULSE)

  ; === Section B: Variation (32 notes) ===
  ; Bar 9-10: Higher energy
  (db apu/NOTE_E4  apu/DYN_PP apu/DUR_QUARTER       apu/WAVE_PULSE)
  (db apu/NOTE_D4  apu/DYN_PP apu/DUR_QUARTER       apu/WAVE_PULSE)
  (db apu/NOTE_C4  apu/DYN_PP apu/DUR_QUARTER       apu/WAVE_PULSE)
  (db apu/NOTE_D4  apu/DYN_PP apu/DUR_QUARTER       apu/WAVE_PULSE)
  (db apu/NOTE_E4  apu/DYN_PP apu/DUR_HALF          apu/WAVE_PULSE)
  (db apu/NOTE_G4  apu/DYN_PP apu/DUR_QUARTER       apu/WAVE_PULSE)
  (db apu/NOTE_E4  apu/DYN_PP apu/DUR_QUARTER       apu/WAVE_PULSE)
  (db apu/NOTE_D4  apu/DYN_PP apu/DUR_HALF          apu/WAVE_PULSE)
  ; Bar 11-12
  (db apu/NOTE_C4  apu/DYN_PP apu/DUR_QUARTER       apu/WAVE_PULSE)
  (db apu/NOTE_A3  apu/DYN_PP apu/DUR_QUARTER       apu/WAVE_PULSE)
  (db apu/NOTE_G3  apu/DYN_PP apu/DUR_QUARTER       apu/WAVE_PULSE)
  (db apu/NOTE_A3  apu/DYN_PP apu/DUR_QUARTER       apu/WAVE_PULSE)
  (db apu/NOTE_C4  apu/DYN_PP apu/DUR_HALF          apu/WAVE_PULSE)
  (db apu/NOTE_D4  apu/DYN_PP apu/DUR_QUARTER       apu/WAVE_PULSE)
  (db apu/NOTE_C4  apu/DYN_PP apu/DUR_QUARTER       apu/WAVE_PULSE)
  (db apu/NOTE_A3  apu/DYN_PP apu/DUR_HALF          apu/WAVE_PULSE)
  ; Bar 13-14: Syncopated
  (db apu/NOTE_G3  apu/DYN_PP apu/DUR_DOTTED_QUARTER apu/WAVE_PULSE)
  (db apu/NOTE_REST 0         apu/DUR_EIGHTH        apu/WAVE_PULSE)
  (db apu/NOTE_G3  apu/DYN_PP apu/DUR_QUARTER       apu/WAVE_PULSE)
  (db apu/NOTE_A3  apu/DYN_PP apu/DUR_DOTTED_QUARTER apu/WAVE_PULSE)
  (db apu/NOTE_REST 0         apu/DUR_EIGHTH        apu/WAVE_PULSE)
  (db apu/NOTE_A3  apu/DYN_PP apu/DUR_QUARTER       apu/WAVE_PULSE)
  (db apu/NOTE_C4  apu/DYN_PP apu/DUR_DOTTED_QUARTER apu/WAVE_PULSE)
  (db apu/NOTE_REST 0         apu/DUR_EIGHTH        apu/WAVE_PULSE)
  ; Bar 15-16: Resolve to theme
  (db apu/NOTE_C4  apu/DYN_PP apu/DUR_QUARTER       apu/WAVE_PULSE)
  (db apu/NOTE_D4  apu/DYN_PP apu/DUR_DOTTED_QUARTER apu/WAVE_PULSE)
  (db apu/NOTE_C4  apu/DYN_PP apu/DUR_QUARTER       apu/WAVE_PULSE)
  (db apu/NOTE_A3  apu/DYN_PP apu/DUR_QUARTER       apu/WAVE_PULSE)
  (db apu/NOTE_G3  apu/DYN_PP apu/DUR_HALF          apu/WAVE_PULSE)
  (db apu/NOTE_REST 0         apu/DUR_HALF          apu/WAVE_PULSE)

  ; === Section C: Bridge (32 notes) ===
  ; Bar 17-18: Lower register
  (db apu/NOTE_G2  apu/DYN_PP apu/DUR_QUARTER       apu/WAVE_PULSE)
  (db apu/NOTE_C3  apu/DYN_PP apu/DUR_QUARTER       apu/WAVE_PULSE)
  (db apu/NOTE_E3  apu/DYN_PP apu/DUR_QUARTER       apu/WAVE_PULSE)
  (db apu/NOTE_G3  apu/DYN_PP apu/DUR_QUARTER       apu/WAVE_PULSE)
  (db apu/NOTE_E3  apu/DYN_PP apu/DUR_QUARTER       apu/WAVE_PULSE)
  (db apu/NOTE_C3  apu/DYN_PP apu/DUR_QUARTER       apu/WAVE_PULSE)
  (db apu/NOTE_G2  apu/DYN_PP apu/DUR_HALF          apu/WAVE_PULSE)
  (db apu/NOTE_REST 0         apu/DUR_HALF          apu/WAVE_PULSE)
  ; Bar 19-20
  (db apu/NOTE_A2  apu/DYN_PP apu/DUR_QUARTER       apu/WAVE_PULSE)
  (db apu/NOTE_C3  apu/DYN_PP apu/DUR_QUARTER       apu/WAVE_PULSE)
  (db apu/NOTE_E3  apu/DYN_PP apu/DUR_QUARTER       apu/WAVE_PULSE)
  (db apu/NOTE_A3  apu/DYN_PP apu/DUR_QUARTER       apu/WAVE_PULSE)
  (db apu/NOTE_E3  apu/DYN_PP apu/DUR_QUARTER       apu/WAVE_PULSE)
  (db apu/NOTE_C3  apu/DYN_PP apu/DUR_QUARTER       apu/WAVE_PULSE)
  (db apu/NOTE_A2  apu/DYN_PP apu/DUR_HALF          apu/WAVE_PULSE)
  (db apu/NOTE_REST 0         apu/DUR_HALF          apu/WAVE_PULSE)
  ; Bar 21-22: Build up
  (db apu/NOTE_C3  apu/DYN_PP apu/DUR_QUARTER       apu/WAVE_PULSE)
  (db apu/NOTE_D3  apu/DYN_PP apu/DUR_QUARTER       apu/WAVE_PULSE)
  (db apu/NOTE_E3  apu/DYN_PP apu/DUR_QUARTER       apu/WAVE_PULSE)
  (db apu/NOTE_F3  apu/DYN_PP apu/DUR_QUARTER       apu/WAVE_PULSE)
  (db apu/NOTE_G3  apu/DYN_PP apu/DUR_QUARTER       apu/WAVE_PULSE)
  (db apu/NOTE_A3  apu/DYN_PP apu/DUR_QUARTER       apu/WAVE_PULSE)
  (db apu/NOTE_B3  apu/DYN_PP apu/DUR_QUARTER       apu/WAVE_PULSE)
  (db apu/NOTE_C4  apu/DYN_PP apu/DUR_QUARTER       apu/WAVE_PULSE)
  ; Bar 23-24: Climax and resolve
  (db apu/NOTE_E4  apu/DYN_PP apu/DUR_QUARTER       apu/WAVE_PULSE)
  (db apu/NOTE_G4  apu/DYN_P  apu/DUR_QUARTER       apu/WAVE_PULSE)
  (db apu/NOTE_E4  apu/DYN_PP apu/DUR_QUARTER       apu/WAVE_PULSE)
  (db apu/NOTE_C4  apu/DYN_PP apu/DUR_QUARTER       apu/WAVE_PULSE)
  (db apu/NOTE_G3  apu/DYN_PP apu/DUR_HALF          apu/WAVE_PULSE)
  (db apu/NOTE_C3  apu/DYN_PP apu/DUR_HALF          apu/WAVE_PULSE))
