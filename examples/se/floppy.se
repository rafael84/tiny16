; Floppy - Side-scrolling arcade game
;
; Gameplay:
; - Press A to start the game
; - Press A to flap and fly upward
; - Avoid the pipes (top and bottom)
; - Bird dies if it hits pipes or boundaries
; - Press A to restart after game over
;
; Features:
; - 8.8 fixed-point subpixel physics
; - Animated bird sprite
; - Visual boundaries
; - Sound effects
;
; BUILD:
;   make examples-se
;   ./build/tiny16-emu build/floppy_se.tiny16

; Tileset: tiles at 0x5000, palette at 0x9200
(include "../examples/includes/tileset.inc")


(def OAM_ADDR           0x9000)
(def OAM_HI             (hi OAM_ADDR))
(def OAM_LO             (lo OAM_ADDR))

; Sprite attributes
(def SPRITE_BEHIND_BG   0x20)

(def TILEMAP_ADDR       0x7000)
(def TILEMAP_HI         (hi TILEMAP_ADDR))

(def MMIO_BASE          0xBF00)
(def KEYS_PRESSED       (+ MMIO_BASE 0x01))  ; edge-detected (just pressed)
(def FRAME_COUNT        (+ MMIO_BASE 0x22))
(def PPU_CTRL           (+ MMIO_BASE 0x30))
(def PPU_BG_SPRITES     0x83)

; APU
(def APU_CTRL           (+ MMIO_BASE 0x40))
(def APU_CH0_FREQ_LO    (+ MMIO_BASE 0x42))
(def APU_CH0_FREQ_HI    (+ MMIO_BASE 0x43))
(def APU_CH0_VOL        (+ MMIO_BASE 0x44))
(def APU_CH0_CTRL       (+ MMIO_BASE 0x45))
(def APU_CH0_ENV_AD     (+ MMIO_BASE 0x51))
(def APU_CH0_ENV_SR     (+ MMIO_BASE 0x52))
(def APU_CH0_LEN        (+ MMIO_BASE 0x5B))
(def APU_CH3_PERIOD     (+ MMIO_BASE 0x4E))
(def APU_CH3_VOL        (+ MMIO_BASE 0x4F))
(def APU_CH3_CTRL       (+ MMIO_BASE 0x50))
(def APU_CH3_ENV_AD     (+ MMIO_BASE 0x57))
(def APU_CH3_ENV_SR     (+ MMIO_BASE 0x58))
(def APU_CH3_LEN        (+ MMIO_BASE 0x5E))

(def KEY_A              0x04)

; Game states
(def STATE_WAITING      0)
(def STATE_PLAYING      1)
(def STATE_DEAD         2)

; Delay before allowing restart (in frames, ~60fps)
(def RESTART_DELAY      45)

; Text display positions (tile coordinates)
(def TEXT_ROW1          5)
(def TEXT_ROW2          6)
(def TEXT_COL           4)
(def TEXT_MAX_LEN       9)

; Playable area (inside boundaries)
(def AREA_TOP           20)
(def AREA_BOTTOM        108)

; Bird
(def BIRD_X             24)
(def BIRD_START_Y       60)

; Pipe
(def PIPE_GAP           34)
(def PIPE_WIDTH         8)
(def PIPE_SPEED         1)
(def PIPE_SPAWN_X       136)
(def PIPE_SPACING       70)
(def GAP_MIN            38)
(def GAP_RANGE          50)

; Pipe data structure offsets (3 bytes per pipe)
(def PIPE_OFF_X         0)
(def PIPE_OFF_GAP_Y     1)
(def PIPE_OFF_PASSED    2)

; Physics (8.8 fixed-point constants)
(def GRAVITY_HI         0)
(def GRAVITY_LO         70)         ; ~0.27 per frame
(def FLAP_VEL_HI        (- 256 3))  ; -3 upward velocity (two's complement)
(def FLAP_VEL_LO        0)
(def MAX_FALL_HI        4)
(def MAX_FALL_LO        0)

; =============================================================================
; Constants - Tiles
; =============================================================================

; Bird animation frames
(def TILE_BIRD_UP       41)
(def TILE_BIRD_MID      40)
(def TILE_BIRD_DOWN     42)

; Pipe tiles
(def TILE_PIPE_CAP_UP   39)
(def TILE_PIPE_BODY     55)
(def TILE_PIPE_CAP_DN   71)

; Boundary tiles
; Sky: top 2 rows
(def TILE_SKY_TOP       2)
(def TILE_SKY_BOT       1)
; Ground: bottom 3 rows
(def TILE_GROUND_TOP    81)
(def TILE_GROUND_MID    97)
(def TILE_GROUND_BOT    113)

; Digit tiles (tile = 96 + ASCII)
; ASCII '0' = 48, so digit 0 is at tile 96 + 48 = 144
(def TILE_DIGIT_0       144)

; Button icon tile
(def TILE_BUTTON_A      193)

; Score display position (top right)
(def SCORE_X            112)
(def SCORE_Y            4)

; Sprite allocation
(def SPR_BIRD           0)
(def SPR_PIPE1_BASE     1)
(def SPR_PIPE2_BASE     15)
(def SPR_SCORE_TENS     29)
(def SPR_SCORE_ONES     30)
(def PIPE_SPRITES       14)

; General constants
(def TILE_SIZE          8)
(def SCREEN_WIDTH       128)
(def SCREEN_TILES       16)
(def NUM_SPRITES        64)
(def SPRITE_HIDDEN_Y    255)
(def NEGATIVE_THRESHOLD 128)
(def PIPE_VISIBLE_MAX   138)
(def BIRD_SIZE          6)
(def ANIM_GOING_UP      2)
(def ANIM_FALLING       0)
(def ANIM_NEUTRAL       1)
(def VEL_NEUTRAL_MAX    2)
(def INIT_FLAG          0xAA)
(def RANDOM_OFFSET      37)

; Tilemap row indices
(def TILE_ROW_SKY1      0)
(def TILE_ROW_SKY2      1)
(def TILE_ROW_SKY3      2)
(def TILE_ROW_GROUND1   13)
(def TILE_ROW_GROUND2   14)
(def TILE_ROW_GROUND3   15)

; =============================================================================
; Helpers
; =============================================================================

(defn read-frame ()
  (peek16 FRAME_COUNT))

(defn wait-frame ()
  (let (last (peek16 last_frame)
        curr (read-frame))
    (while (= curr last)
      (set curr (read-frame)))
    (poke16 last_frame curr)))

(defn mod-by (v d)
  (let (r v)
    (while (>= r d)
      (set r (- r d)))
    r))

(defn oam-addr (idx)
  (+ OAM_LO (<< idx 2)))

(defn draw-spr (idx y x tile)
  (let (a (oam-addr idx))
    (poke OAM_HI a y)
    (poke OAM_HI (+ a 1) x)
    (poke OAM_HI (+ a 2) tile)
    (poke OAM_HI (+ a 3) 0)))

(defn draw-spr-attr (idx y x tile attr)
  (let (a (oam-addr idx))
    (poke OAM_HI a y)
    (poke OAM_HI (+ a 1) x)
    (poke OAM_HI (+ a 2) tile)
    (poke OAM_HI (+ a 3) attr)))

(defn render ()
  (poke16 PPU_CTRL PPU_BG_SPRITES))

; =============================================================================
; Tilemap Helpers
; =============================================================================

; Write a tile to tilemap at (tx, ty) - tile coordinates
; Tilemap entry = 2 bytes: tile index + attribute
; Address = 0x7000 + (ty * 128 + tx) * 2
; Each row = 128 tiles * 2 bytes = 256 bytes (one page)
; High byte = 0x70 + ty
; Low byte = tx * 2
(defn tilemap-set (tx ty tile)
  (let (addr-hi (+ TILEMAP_HI ty)
        addr-lo (<< tx 1))
    (poke addr-hi addr-lo tile)
    (poke addr-hi (+ addr-lo 1) 0)))

; Fill a row of tilemap with a tile
(defn tilemap-fill-row (ty tile)
  (let (x 0)
    (while (< x SCREEN_TILES)
      (tilemap-set x ty tile)
      (set x (inc x)))))

; Initialize tilemap with sky and ground boundaries
(defn init-tilemap ()
  ; Sky: 3 rows at top
  (tilemap-fill-row TILE_ROW_SKY1 TILE_SKY_TOP)
  (tilemap-fill-row TILE_ROW_SKY2 TILE_SKY_TOP)
  (tilemap-fill-row TILE_ROW_SKY3 TILE_SKY_BOT)

  ; Ground: 3 rows at bottom
  (tilemap-fill-row TILE_ROW_GROUND1 TILE_GROUND_TOP)
  (tilemap-fill-row TILE_ROW_GROUND2 TILE_GROUND_MID)
  (tilemap-fill-row TILE_ROW_GROUND3 TILE_GROUND_BOT))

; =============================================================================
; Text Display
; =============================================================================

; Draw text string to tilemap at (tx, ty)
; str-hi, str-lo: 16-bit address of null-terminated string
; ASCII chars are converted to tile indices (tile = 96 + ASCII)
(defn tilemap-text (tx ty str-hi str-lo)
  (let (x tx
        ptr-hi str-hi
        ptr-lo str-lo)
    (while (!= (peek ptr-hi ptr-lo) 0)
      (let (ch (peek ptr-hi ptr-lo)
            tile (+ 96 ch))
        (tilemap-set x ty tile)
        (set x (inc x))
        (set ptr-lo (inc ptr-lo))
        (if (= ptr-lo 0)
            (set ptr-hi (inc ptr-hi))
            0)))))

; Clear text area (both rows)
(defn clear-text ()
  (let (x 0)
    (while (< x TEXT_MAX_LEN)
      (tilemap-set (+ TEXT_COL x) TEXT_ROW1 0)
      (tilemap-set (+ TEXT_COL x) TEXT_ROW2 0)
      (set x (inc x)))))

; Show "PRESS A" message (centered on row 1)
(defn show-press-a ()
  (tilemap-text (+ TEXT_COL 1) TEXT_ROW1 (hi str_press_a) (lo str_press_a)))

; Show "GAME OVER" and "PRESS A" messages
(defn show-game-over ()
  (tilemap-text TEXT_COL TEXT_ROW1 (hi str_game_over) (lo str_game_over))
  (tilemap-text (+ TEXT_COL 1) TEXT_ROW2 (hi str_press_a) (lo str_press_a)))

; =============================================================================
; Sound Effects
; =============================================================================

(defn apu-init ()
  (poke16 APU_CTRL 0x81))

(defn sfx-flap ()
  (poke16 APU_CH0_ENV_AD 0x11)
  (poke16 APU_CH0_ENV_SR 0x81)
  (poke16 APU_CH0_LEN 3)
  (poke16 APU_CH0_FREQ_LO 0xC8)
  (poke16 APU_CH0_FREQ_HI 0x07)
  (poke16 APU_CH0_VOL 0x12)
  (poke16 APU_CH0_CTRL 0x03))

(defn sfx-die ()
  (poke16 APU_CH3_ENV_AD 0x15)
  (poke16 APU_CH3_ENV_SR 0x04)
  (poke16 APU_CH3_LEN 18)
  (poke16 APU_CH3_PERIOD 9)
  (poke16 APU_CH3_VOL 14)
  (poke16 APU_CH3_CTRL 0x03))

(defn sfx-score ()
  (poke16 APU_CH0_ENV_AD 0x11)
  (poke16 APU_CH0_ENV_SR 0x61)
  (poke16 APU_CH0_LEN 4)
  (poke16 APU_CH0_FREQ_LO 0xD0)
  (poke16 APU_CH0_FREQ_HI 0x07)
  (poke16 APU_CH0_VOL 0x2C)
  (poke16 APU_CH0_CTRL 0x03))

; =============================================================================
; Fixed-Point Helpers
; =============================================================================

; Add gravity to velocity
(defn add-gravity ()
  (let (v-lo (peek16 bird_vel_lo)
        new-lo (+ v-lo GRAVITY_LO)
        carry (if (< new-lo v-lo) 1 0)
        v-hi (peek16 bird_vel_hi)
        new-hi (+ v-hi (+ GRAVITY_HI carry)))
    (poke16 bird_vel_hi new-hi)
    (poke16 bird_vel_lo new-lo)))

; Add velocity to position
(defn apply-velocity ()
  (let (y-lo (peek16 bird_y_lo)
        v-lo (peek16 bird_vel_lo)
        new-lo (+ y-lo v-lo)
        carry (if (< new-lo y-lo) 1 0)
        y-hi (peek16 bird_y_hi)
        v-hi (peek16 bird_vel_hi)
        new-hi (+ y-hi (+ v-hi carry)))
    (poke16 bird_y_hi new-hi)
    (poke16 bird_y_lo new-lo)))

; Set flap velocity
(defn set-flap-velocity ()
  (poke16 bird_vel_hi FLAP_VEL_HI)
  (poke16 bird_vel_lo FLAP_VEL_LO))

; Clamp fall speed
(defn clamp-velocity ()
  (let (v-hi (peek16 bird_vel_hi))
    (if (< v-hi NEGATIVE_THRESHOLD)
        (if (> v-hi MAX_FALL_HI)
            (do
              (poke16 bird_vel_hi MAX_FALL_HI)
              (poke16 bird_vel_lo MAX_FALL_LO))
            0)
        0)))

; =============================================================================
; Game Init
; =============================================================================

(defn hide-sprites ()
  (let (i 0)
    (while (< i NUM_SPRITES)
      (draw-spr i SPRITE_HIDDEN_Y 0 0)
      (set i (inc i)))))

; Initialize a single pipe
(defn init-single-pipe (data-hi data-lo x gap-y)
  (poke data-hi (+ data-lo PIPE_OFF_X) x)
  (poke data-hi (+ data-lo PIPE_OFF_GAP_Y) gap-y)
  (poke data-hi (+ data-lo PIPE_OFF_PASSED) 0))

(defn init-pipe ()
  (let (seed (read-frame)
        gap1 (+ GAP_MIN (mod-by seed GAP_RANGE))
        gap2 (+ GAP_MIN (mod-by (+ seed RANDOM_OFFSET) GAP_RANGE)))
    (init-single-pipe (hi pipe1_data) (lo pipe1_data) PIPE_SPAWN_X gap1)
    (init-single-pipe (hi pipe2_data) (lo pipe2_data) (+ PIPE_SPAWN_X PIPE_SPACING) gap2)))

(defn init-game ()
  (hide-sprites)
  ; Bird position (8.8)
  (poke16 bird_y_hi BIRD_START_Y)
  (poke16 bird_y_lo 0)
  ; Velocity (8.8)
  (poke16 bird_vel_hi 0)
  (poke16 bird_vel_lo 0)
  ; State
  (poke16 game_state STATE_WAITING)
  (poke16 score 0)
  (poke16 anim_frame 0)
  (init-pipe)
  ; Show "PRESS A" message
  (show-press-a))

; =============================================================================
; Bird Physics
; =============================================================================

; Handle death: set state, show message, play sound
(defn die ()
  (poke16 game_state STATE_DEAD)
  (poke16 dead_timer 0)
  (show-game-over)
  (sfx-die))

; Start playing: clear text and set state
(defn start-game ()
  (clear-text)
  (poke16 game_state STATE_PLAYING))

(defn update-bird (keys)
  ; Flap on A press
  (if (!= (& keys KEY_A) 0)
      (do
        (set-flap-velocity)
        (sfx-flap))
      0)

  ; Physics
  (add-gravity)
  (clamp-velocity)
  (apply-velocity)

  ; Check boundaries
  (let (y-hi (peek16 bird_y_hi))
    ; Hit ceiling (wrapped negative)
    (if (>= y-hi NEGATIVE_THRESHOLD)
        (do
          (poke16 bird_y_hi AREA_TOP)
          (poke16 bird_y_lo 0)
          (die))
        ; Hit floor
        (if (> y-hi (- AREA_BOTTOM TILE_SIZE))
            (do
              (poke16 bird_y_hi (- AREA_BOTTOM TILE_SIZE))
              (poke16 bird_y_lo 0)
              (die))
            0)))

  ; Update animation (based on velocity)
  (let (v-hi (peek16 bird_vel_hi))
    (if (>= v-hi NEGATIVE_THRESHOLD)
        (poke16 anim_frame ANIM_GOING_UP)
        (if (> v-hi VEL_NEUTRAL_MAX)
            (poke16 anim_frame ANIM_FALLING)
            (poke16 anim_frame ANIM_NEUTRAL)))))

; =============================================================================
; Pipe Logic
; =============================================================================

(defn update-pipe (data-hi data-lo)
  (let (x (peek data-hi (+ data-lo PIPE_OFF_X))
        gap-y (peek data-hi (+ data-lo PIPE_OFF_GAP_Y))
        passed (peek data-hi (+ data-lo PIPE_OFF_PASSED)))

    ; Move left
    (if (>= x PIPE_SPEED)
        (set x (- x PIPE_SPEED))
        ; Reset pipe - spawn ahead
        (let (seed (read-frame)
              new-gap (+ GAP_MIN (mod-by seed GAP_RANGE)))
          (set x (+ x (+ PIPE_SPACING PIPE_SPACING)))
          (set gap-y new-gap)
          (set passed 0)))

    ; Scoring
    (if (= passed 0)
        (if (< x BIRD_X)
            (do
              (set passed 1)
              (poke16 score (inc (peek16 score)))
              (sfx-score))
            0)
        0)

    (poke data-hi (+ data-lo PIPE_OFF_X) x)
    (poke data-hi (+ data-lo PIPE_OFF_GAP_Y) gap-y)
    (poke data-hi (+ data-lo PIPE_OFF_PASSED) passed)))

(defn update-pipes ()
  (update-pipe (hi pipe1_data) (lo pipe1_data))
  (update-pipe (hi pipe2_data) (lo pipe2_data)))

; =============================================================================
; Collision
; =============================================================================

; Check collision with a single pipe, returns 1 if hit, 0 otherwise
(defn check-pipe-hit (data-hi data-lo by half)
  (let (px (peek data-hi (+ data-lo PIPE_OFF_X))
        gap-y (peek data-hi (+ data-lo PIPE_OFF_GAP_Y))
        gap-top (- gap-y half)
        gap-bot (+ gap-y half))
    (if (< px SCREEN_WIDTH)
        (if (< px (+ BIRD_X BIRD_SIZE))
            (if (> (+ px PIPE_WIDTH) BIRD_X)
                (if (< by gap-top)
                    1
                    (if (> (+ by BIRD_SIZE) gap-bot)
                        1
                        0))
                0)
            0)
        0)))

(defn check-collision ()
  (let (by (peek16 bird_y_hi)
        half (>> PIPE_GAP 1)
        hit1 (check-pipe-hit (hi pipe1_data) (lo pipe1_data) by half)
        hit2 (check-pipe-hit (hi pipe2_data) (lo pipe2_data) by half))
    (if (!= (| hit1 hit2) 0)
        (die)
        0)))

; =============================================================================
; Rendering
; =============================================================================

(defn render-bird ()
  (let (y (peek16 bird_y_hi)
        anim (peek16 anim_frame)
        tile TILE_BIRD_MID)
    (if (= anim ANIM_FALLING)
        (set tile TILE_BIRD_UP)
        (if (= anim ANIM_GOING_UP)
            (set tile TILE_BIRD_DOWN)
            (set tile TILE_BIRD_MID)))
    (draw-spr SPR_BIRD y BIRD_X tile)))

(defn render-pipe (data-hi data-lo base)
  (let (px (peek data-hi (+ data-lo PIPE_OFF_X))
        gap-y (peek data-hi (+ data-lo PIPE_OFF_GAP_Y))
        half (>> PIPE_GAP 1)
        gap-top (- gap-y half)
        gap-bot (+ gap-y half))

    (if (< px PIPE_VISIBLE_MAX)
        (do
          ; Top pipe (behind background so sky/ground covers it)
          (draw-spr-attr base (- gap-top TILE_SIZE) px TILE_PIPE_CAP_DN SPRITE_BEHIND_BG)
          (draw-spr-attr (+ base 1) (- gap-top (* TILE_SIZE 2)) px TILE_PIPE_BODY SPRITE_BEHIND_BG)
          (draw-spr-attr (+ base 2) (- gap-top (* TILE_SIZE 3)) px TILE_PIPE_BODY SPRITE_BEHIND_BG)
          (draw-spr-attr (+ base 3) (- gap-top (* TILE_SIZE 4)) px TILE_PIPE_BODY SPRITE_BEHIND_BG)
          (draw-spr-attr (+ base 4) (- gap-top (* TILE_SIZE 5)) px TILE_PIPE_BODY SPRITE_BEHIND_BG)
          (draw-spr-attr (+ base 5) (- gap-top (* TILE_SIZE 6)) px TILE_PIPE_BODY SPRITE_BEHIND_BG)
          (draw-spr-attr (+ base 6) (- gap-top (* TILE_SIZE 7)) px TILE_PIPE_BODY SPRITE_BEHIND_BG)
          ; Bottom pipe (behind background so sky/ground covers it)
          (draw-spr-attr (+ base 7) gap-bot px TILE_PIPE_CAP_UP SPRITE_BEHIND_BG)
          (draw-spr-attr (+ base 8) (+ gap-bot TILE_SIZE) px TILE_PIPE_BODY SPRITE_BEHIND_BG)
          (draw-spr-attr (+ base 9) (+ gap-bot (* TILE_SIZE 2)) px TILE_PIPE_BODY SPRITE_BEHIND_BG)
          (draw-spr-attr (+ base 10) (+ gap-bot (* TILE_SIZE 3)) px TILE_PIPE_BODY SPRITE_BEHIND_BG)
          (draw-spr-attr (+ base 11) (+ gap-bot (* TILE_SIZE 4)) px TILE_PIPE_BODY SPRITE_BEHIND_BG)
          (draw-spr-attr (+ base 12) (+ gap-bot (* TILE_SIZE 5)) px TILE_PIPE_BODY SPRITE_BEHIND_BG)
          (draw-spr-attr (+ base 13) (+ gap-bot (* TILE_SIZE 6)) px TILE_PIPE_BODY SPRITE_BEHIND_BG))
        ; Hide if off screen
        (let (i 0)
          (while (< i PIPE_SPRITES)
            (draw-spr (+ base i) SPRITE_HIDDEN_Y 0 0)
            (set i (inc i)))))))

(defn render-pipes ()
  (render-pipe (hi pipe1_data) (lo pipe1_data) SPR_PIPE1_BASE)
  (render-pipe (hi pipe2_data) (lo pipe2_data) SPR_PIPE2_BASE))

; Boundaries are now rendered via tilemap (set once at init)
; No per-frame sprite rendering needed

; Render score as 2 digits on top right
(defn render-score ()
  (let (s (peek16 score)
        tens 0
        ones s)
    ; Calculate tens digit (s / 10)
    (while (>= ones 10)
      (set tens (inc tens))
      (set ones (- ones 10)))
    ; Draw tens digit - hide if zero
    (if (> tens 0)
        (draw-spr SPR_SCORE_TENS SCORE_Y (- SCORE_X TILE_SIZE) (+ TILE_DIGIT_0 tens))
        (draw-spr SPR_SCORE_TENS SPRITE_HIDDEN_Y 0 0))
    ; Draw ones digit
    (draw-spr SPR_SCORE_ONES SCORE_Y SCORE_X (+ TILE_DIGIT_0 ones))))

(defn render-all ()
  (render-bird)
  (render-pipes)
  (render-score)
  (render))

; =============================================================================
; Main
; =============================================================================

(defn main ()
  ; One-time init
  (if (!= (peek16 initialized) INIT_FLAG)
      (do
        (apu-init)
        (init-tilemap)
        (init-game)
        (poke16 initialized INIT_FLAG))
      0)

  ; Game loop
  (while 1
    (wait-frame)

    (let (state (peek16 game_state)
          pressed (peek16 KEYS_PRESSED))  ; edge-detected by emulator

      ; State machine
      (if (= state STATE_WAITING)
          ; Waiting for player to press A to start
          (if (!= (& pressed KEY_A) 0)
              (do
                (start-game)
                (set-flap-velocity)
                (sfx-flap))
              0)
          (if (= state STATE_DEAD)
              ; Game over - wait for delay then A to restart
              (let (timer (peek16 dead_timer))
                (if (< timer RESTART_DELAY)
                    ; Still in delay period, increment timer
                    (poke16 dead_timer (inc timer))
                    ; Delay passed, allow restart on A press
                    (if (!= (& pressed KEY_A) 0)
                        (do
                          (init-game)
                          (start-game)
                          (set-flap-velocity)
                          (sfx-flap))
                        0)))
              ; Playing
              (do
                (update-bird pressed)
                (if (= (peek16 game_state) STATE_PLAYING)
                    (do
                      (update-pipes)
                      (check-collision))
                    0)))))

    (render-all)))

; System
(data initialized (db 0))
(data last_frame (db 0))

; Game state
(data game_state (db 0))
(data score (db 0))
(data dead_timer (db 0))

; Bird position (8.8 fixed-point)
(data bird_y_hi (db 0))
(data bird_y_lo (db 0))

; Bird velocity (8.8 fixed-point)
(data bird_vel_hi (db 0))
(data bird_vel_lo (db 0))

; Pipe data (3 bytes each: x, gap_y, passed)
(data pipe1_data (db 0 0 0))
(data pipe2_data (db 0 0 0))

; Animation
(data anim_frame (db 0))

; Text strings (null-terminated)
(data str_press_a (db "PRESS " (- TILE_BUTTON_A 96) 0))
(data str_game_over (db "GAME OVER" 0))
