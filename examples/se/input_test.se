; Input Test - Move a Square with Keyboard
;
; Controls:
; - Arrow keys: Move sprite
; - A button: Change color
;
; BUILD:
;   make examples-se
;   ./build/tiny16-emu build/input_test_se.tiny16

(require (core sprite input ppu palette))

(def BOUNDARY 120)
(def CENTER_POS 60)
(def COLOR_TOGGLE 0x1C)
(def SOLID_PIXEL 0x11)
(def TILE_OFFSET 1)
(def TILE_SIZE_BYTES 32)
(def BG_COLOR 0x03)
(def DEFAULT_COLOR 0xFC)

; Generate solid square tile in tile memory at 0x5020
(defn init-square-tile ()
  (let (i 0)
    (while (< i TILE_SIZE_BYTES)
      (poke 0x50 (+ 0x20 i) SOLID_PIXEL)
      (set i (inc i)))))

(defn update-position ()
  (let (keys (input/keys-held)
        x (peek16 sprite_x)
        y (peek16 sprite_y))

    (if (input/right)
        (if (< x BOUNDARY)
            (set x (+ x 1))
            0)
        0)
    (if (input/left)
        (if (> x 0)
            (set x (- x 1))
            0)
        0)
    (if (input/down)
        (if (< y BOUNDARY)
            (set y (+ y 1))
            0)
        0)
    (if (input/up)
        (if (> y 0)
            (set y (- y 1))
            0)
        0)

    (poke16 sprite_x x)
    (poke16 sprite_y y)))

(defn update-color ()
  (if (input/key-pressed input/KEY_A)
      (let (color (peek16 sprite_color)
            new-color (+ color COLOR_TOGGLE))
        (palette/set-color 1 new-color)
        (poke16 sprite_color new-color))
      0))

(defn main ()
  (init-square-tile)
  (sprite/hide-all)
  (palette/set-color 0 BG_COLOR)
  (palette/set-color 1 DEFAULT_COLOR)
  (poke16 sprite_x CENTER_POS)
  (poke16 sprite_y CENTER_POS)
  (poke16 sprite_color DEFAULT_COLOR)

  (while 1
    (core/wait-frame)
    (update-position)
    (update-color)
    (sprite/draw 0 (peek16 sprite_y) (peek16 sprite_x) TILE_OFFSET)
    (ppu/render-sprites-only)))

(data sprite_x (db 0))
(data sprite_y (db 0))
(data sprite_color (db 0))
