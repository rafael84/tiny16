; Input Test - Move a Square with Keyboard
;
; Controls:
; - Arrow keys: Move sprite
; - A button: Change color
;
; BUILD:
;   make examples-se
;   ./build/tiny16-emu build/input_test_se.tiny16

(require (core sprite input ppu palette))

(def BOUNDARY 120)
(def CENTER_POS 60)
(def COLOR_TOGGLE 0x1C)
(def SOLID_PIXEL 0x11)
(def TILE_OFFSET 1)
(def TILE_SIZE_BYTES 32)
(def BG_COLOR 0x03)
(def DEFAULT_COLOR 0xFC)

(var sprite-x CENTER_POS)
(var sprite-y CENTER_POS)
(var sprite-color DEFAULT_COLOR)

; Generate solid square tile in tile memory at 0x5020
(defn init-square-tile ()
  (for (i (range 0 TILE_SIZE_BYTES))
    (core/poke 0x50 (+ 0x20 i) SOLID_PIXEL)))

(defn update-position ()
  (let (keys (input/keys-held)
        x sprite-x
        y sprite-y)

    (when (input/right)
      (when (< x BOUNDARY)
        (set! sprite-x (+ x 1))))
    (when (input/left)
      (when (> x 0)
        (set! sprite-x (- x 1))))
    (when (input/down)
      (when (< y BOUNDARY)
        (set! sprite-y (+ y 1))))
    (when (input/up)
      (when (> y 0)
        (set! sprite-y (- y 1))))))

(defn update-color ()
  (when (input/key-pressed input/KEY_A)
    (let (color sprite-color
          new-color (+ color COLOR_TOGGLE))
      (palette/set-color 1 new-color)
      (set! sprite-color new-color))))

(defn main ()
  (init-square-tile)
  (sprite/hide-all)
  (palette/set-color 0 BG_COLOR)
  (palette/set-color 1 DEFAULT_COLOR)
  (set! sprite-x CENTER_POS)
  (set! sprite-y CENTER_POS)
  (set! sprite-color DEFAULT_COLOR)

  (while 1
    (core/wait-frame)
    (update-position)
    (update-color)
    (sprite/draw 0 sprite-y sprite-x TILE_OFFSET)
    (ppu/render-sprites-only)))
