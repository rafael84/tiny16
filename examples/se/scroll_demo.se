; Scroll Demo - PPU Tilemap Scrolling
;
; Demonstrates PPU scroll registers for smooth tilemap scrolling
; with arrow key control.
;
; BUILD:
;   make examples-se
;   ./build/tiny16-emu build/scroll_demo_se.tiny16

(require (core tilemap input ppu))
(import "../examples/includes/tileset.inc")

(def KEY_ARROWS (| (| input/KEY_UP input/KEY_DOWN) (| input/KEY_LEFT input/KEY_RIGHT)))
(def SCROLL_SPEED 1)

; Determine tile index based on quadrant
(defn get-quadrant-tile (row col)
  (let (tile 3)
    (if (>= row 16)
        (set tile (+ tile 2))
        0)
    (if (>= col 16)
        (set tile (inc tile))
        0)
    tile))

; Initialize tilemap with visible pattern
(defn init-tilemap ()
  ; Fill with alternating tiles to make it visible
  (tilemap/fill-row 0 2)
  (tilemap/fill-row 1 2)
  (tilemap/fill-row 2 3)
  (tilemap/fill-row 3 3)
  (tilemap/fill-row 4 4)
  (tilemap/fill-row 5 4)
  (tilemap/fill-row 6 5)
  (tilemap/fill-row 7 5)
  (tilemap/fill-row 8 6)
  (tilemap/fill-row 9 6)
  (tilemap/fill-row 10 7)
  (tilemap/fill-row 11 7)
  (tilemap/fill-row 12 8)
  (tilemap/fill-row 13 8)
  (tilemap/fill-row 14 9)
  (tilemap/fill-row 15 9))

(defn update-scroll ()
  (let (keys (input/keys-held)
        sx (ppu/get-scroll-x)
        sy (ppu/get-scroll-y))

    (if (!= (& keys KEY_ARROWS) 0)
        (do
          (if (input/left)
              (set sx (- sx SCROLL_SPEED))
              0)
          (if (input/right)
              (set sx (+ sx SCROLL_SPEED))
              0)
          (if (input/up)
              (set sy (- sy SCROLL_SPEED))
              0)
          (if (input/down)
              (set sy (+ sy SCROLL_SPEED))
              0))
        ; Auto-scroll if no keys pressed
        (do
          (set sx (+ sx 1))
          (set sy (+ sy 1))))

    (ppu/set-scroll sx sy)))

(defn main ()
  (init-tilemap)
  (ppu/set-scroll 0 0)

  (while 1
    (core/wait-frame)
    (update-scroll)
    (ppu/render-bg-only)))
