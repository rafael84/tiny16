; Tileset Viewer - Auto-scrolling tileset display
;
; Displays tiles from the tileset using sprites (only renders visible tiles).
;
; BUILD:
;   make examples-se
;   ./build/tiny16-emu build/tileset_viewer_se.tiny16

(require (core sprite ppu))
(import "../examples/includes/tileset.inc")

(def TILES_PER_SCREEN 64)
(def MAX_TILE_INDEX 80)
(def SCROLL_SPEED 8)
(def COLS 8)
(def ROWS 8)
(def TILE_SIZE 8)
(def START_X 32)
(def START_Y 32)

(var tile-offset 0)
(var frame-counter 0)

; Render sprites with tiles starting at offset
; Only renders sprites that have non-transparent pixels
(defn render-sprites (offset)
  (for (row (range 0 ROWS))
    (for (col (range 0 COLS))
      (let (sprite-idx (+ (* row COLS) col)
            tile-index (+ offset sprite-idx)
            x (+ START_X (* col TILE_SIZE))
            y (+ START_Y (* row TILE_SIZE)))
        (if (< tile-index MAX_TILE_INDEX)
            (sprite/draw-visible sprite-idx y x tile-index)
            (sprite/hide sprite-idx))))))

(defn main ()
  (sprite/hide-all)
  (render-sprites 0)
  (set! tile-offset 0)
  (set! frame-counter 0)

  (while 1
    (core/wait-frame)
    (ppu/render-sprites-only)

    ; Count frames for scrolling
    (set! frame-counter (inc frame-counter))
    (when (>= frame-counter SCROLL_SPEED)
      (set! frame-counter 0)
      (set! tile-offset (inc tile-offset))
      (when (>= tile-offset MAX_TILE_INDEX)
        (set! tile-offset 0))
      (render-sprites tile-offset))))
