; Mouse Paint - Draw on screen with mouse
;
; Controls:
; - Left click: Draw white pixel
; - Right click: Erase (draw background)
; - Space key: Clear screen
;
; BUILD:
;   make examples-se
;   ./build/tiny16-emu build/mouse_paint_se.tiny16

(require (core input framebuffer))

(def COLOR_WHITE 0xFF)
(def COLOR_BG 0x03)

(defn main ()
  (framebuffer/clear COLOR_BG)

  (while 1
    (core/wait-frame)

    (let (mx (input/mouse-x)
          my (input/mouse-y)
          buttons (input/mouse-buttons)
          pressed (input/keys-pressed))

      ; Left click: draw white
      (when (input/mouse-left)
        (framebuffer/draw-pixel mx my COLOR_WHITE))

      ; Right click: erase
      (when (input/mouse-right)
        (framebuffer/draw-pixel mx my COLOR_BG))

      ; Space: clear screen
      (when (!= (& pressed input/KEY_SELECT) 0)
        (framebuffer/clear COLOR_BG)))))
