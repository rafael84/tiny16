; framebuffer - direct pixel manipulation (0xC000-0xFFFF)
(ns framebuffer)

(def FB_BASE 0xC000)
(def FB_HI (hi FB_BASE))

; Draw pixel at (x, y) with color
; Framebuffer layout: 128x128 pixels at 0xC000
; Address = 0xC000 + (y * 128) + x
; High byte: 0xC0 + (y / 2)
; Low byte: ((y & 1) * 128) + x
(defn draw-pixel (x y color)
  (let (y-bit (& y 1)
        addr-lo (if (= y-bit 0) x (+ x 128))
        addr-hi (+ FB_HI (/ y 2)))
    (poke addr-hi addr-lo color)))

; Clear framebuffer to color (fast: direct memory write)
; Framebuffer: 0xC000-0xFFFF (64 pages, 256 bytes each)
(defn clear (color)
  (let (hi FB_HI
        lo 0)
    (while (!= hi 0)
      (poke hi lo color)
      (set lo (inc lo))
      (if (= lo 0)
          (set hi (inc hi))
          0))))

; Fill rectangle
(defn fill-rect (x y w h color)
  (let (row 0)
    (while (< row h)
      (let (col 0)
        (while (< col w)
          (draw-pixel (+ x col) (+ y row) color)
          (set col (inc col))))
      (set row (inc row)))))
