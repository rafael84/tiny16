; framebuffer - direct pixel manipulation (v2)
; Framebuffer: 128x128 pixels at 0xC000-0xFFFF
; Address = 0xC000 + (y * 128) + x
; Split: hi = 0xC0 + (y >> 1), lo = ((y & 1) << 7) + x
(ns framebuffer)
(require core)

(def FB_BASE 0xC000)
(def FB_HI (hi FB_BASE))

; Draw pixel at (x, y) with color
(defn draw-pixel (x y color)
  (let (addr-hi (+ FB_HI (>> y 1))
        addr-lo (+ (if (= (& y 1) 0) 0 128) x))
    (core/poke addr-hi addr-lo color)))

; Clear framebuffer to color
; Iterates all 64 pages (0xC0-0xFF), 256 bytes each
(defn clear (color)
  (let (h FB_HI
        l 0)
    (while (!= h 0)
      (core/poke h l color)
      (set! l (inc l))
      (when (= l 0)
        (set! h (inc h))))))

; Fill rectangle
(defn fill-rect (x y w h color)
  (let (row 0)
    (while (< row h)
      (let (col 0)
        (while (< col w)
          (draw-pixel (+ x col) (+ y row) color)
          (set! col (inc col))))
      (set! row (inc row)))))
