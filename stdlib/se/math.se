; math - math utilities and random (v2)
(ns math)

; Absolute value
(defn abs (x)
  (if (< x 0) (- 0 x) x))

; Minimum
(defn min (a b)
  (if (< a b) a b))

; Maximum
(defn max (a b)
  (if (> a b) a b))

; Clamp value between lo and hi
(defn clamp (val lo hi)
  (if (< val lo) lo
      (if (> val hi) hi val)))

; Random number [0, max) using frame counter as seed
(def FRAME_COUNT 0xBF22)
(defn random (max)
  (% (load FRAME_COUNT) max))

; Random number [min, max)
(defn random-range (min-val max-val)
  (+ min-val (random (- max-val min-val))))
