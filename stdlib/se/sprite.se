; sprite - OAM/sprite management (v2: native store/load)
(ns sprite)

(def OAM_BASE 0x9000)
(def TILES_BASE 0x5000)
(def TILE_SIZE_BYTES 32)
(def NUM_SPRITES 64)
(def SPRITE_HIDDEN_Y 255)

; Each sprite = 4 bytes in OAM: Y, X, Tile, Attributes
(defn oam-offset (idx)
  (* idx 4))

; Draw sprite at OAM slot idx
(defn draw (idx y x tile)
  (let (a (oam-offset idx))
    (store (+ OAM_BASE a) y)
    (store (+ OAM_BASE (+ a 1)) x)
    (store (+ OAM_BASE (+ a 2)) tile)
    (store (+ OAM_BASE (+ a 3)) 0)))

; Draw sprite with attributes (flip, priority, etc.)
(defn draw-attr (idx y x tile attr)
  (let (a (oam-offset idx))
    (store (+ OAM_BASE a) y)
    (store (+ OAM_BASE (+ a 1)) x)
    (store (+ OAM_BASE (+ a 2)) tile)
    (store (+ OAM_BASE (+ a 3)) attr)))

; Hide sprite by moving it off-screen
(defn hide (idx)
  (let (a (oam-offset idx))
    (store (+ OAM_BASE a) SPRITE_HIDDEN_Y)
    (store (+ OAM_BASE (+ a 1)) 0)
    (store (+ OAM_BASE (+ a 2)) 0)
    (store (+ OAM_BASE (+ a 3)) 0)))

; Hide all sprites
(defn hide-all ()
  (for (i (range 0 NUM_SPRITES))
    (hide i)))

; Set sprite position
(defn set-pos (idx x y)
  (let (a (oam-offset idx))
    (store (+ OAM_BASE a) y)
    (store (+ OAM_BASE (+ a 1)) x)))

; Set sprite tile
(defn set-tile (idx tile)
  (store (+ OAM_BASE (+ (oam-offset idx) 2)) tile))

; Set sprite attributes
(defn set-attr (idx attr)
  (store (+ OAM_BASE (+ (oam-offset idx) 3)) attr))

; Check if a tile has any non-transparent pixels (palette index != 0)
; Tiles are 8x8 pixels, 4bpp (2 pixels per byte) = 32 bytes
; Returns 1 if tile is visible, 0 if completely transparent
(defn tile-visible? (tile-idx)
  (let (base-lo (* tile-idx TILE_SIZE_BYTES)
        i 0
        visible 0)
    (while (< i TILE_SIZE_BYTES)
      (when (!= (load (+ TILES_BASE (+ base-lo i))) 0)
        (set! visible 1)
        (set! i TILE_SIZE_BYTES))
      (set! i (inc i)))
    visible))

; Draw sprite only if tile has visible (non-transparent) pixels
(defn draw-visible (idx y x tile)
  (if (tile-visible? tile)
      (draw idx y x tile)
      (hide idx)))

; Draw sprite with attributes only if tile is visible
(defn draw-visible-attr (idx y x tile attr)
  (if (tile-visible? tile)
      (draw-attr idx y x tile attr)
      (hide idx)))
