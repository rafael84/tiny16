; apu - audio processing unit
(ns apu)

(def MMIO_BASE 0xBF00)

; =============================================================================
; Waveform Types
; =============================================================================
(def WAVE_TRIANGLE 0)
(def WAVE_TSAW     1)
(def WAVE_SAW      2)
(def WAVE_SQUARE   3)
(def WAVE_PULSE    4)
(def WAVE_ORGAN    5)
(def WAVE_NOISE    6)
(def WAVE_PHASER   7)

; =============================================================================
; Envelope Presets (ADSR)
; =============================================================================
; Format for env_ad: attack[7:4] | decay[3:0]
; Format for env_sr: sustain[7:4] | release[3:0]
; Time values: 0=instant, 1=0.005s, 2=0.01s, 3=0.02s, 4=0.04s, 5=0.06s,
;              6=0.08s, 7=0.10s, 8=0.15s, 9=0.20s, A=0.30s, B=0.40s,
;              C=0.60s, D=0.80s, E=1.00s, F=1.50s
; Sustain values: 0=silent, F=full volume

; Attack/Decay (AD) presets
(def ENV_SMOOTH_AD  0x11)  ; smooth attack/decay for melody
(def ENV_PLUCK_AD   0x12)  ; fast attack, medium decay
(def ENV_ORGAN_AD   0x00)  ; instant on/off
(def ENV_KICK_AD    0x05)  ; instant attack, 0.06s decay (punchy)
(def ENV_SNARE_AD   0x03)  ; instant attack, 0.02s decay (snappy)
(def ENV_HIHAT_AD   0x02)  ; instant attack, 0.01s decay (crisp)
(def ENV_BRASS_AD   0x23)  ; medium attack, medium decay
(def ENV_STRINGS_AD 0x45)  ; slow attack, slow decay

; Sustain/Release (SR) presets
(def ENV_SMOOTH_SR  0xF2)  ; full sustain, fast release
(def ENV_PLUCK_SR   0x03)  ; no sustain, fast decay
(def ENV_ORGAN_SR   0xF0)  ; full sustain, instant release
(def ENV_KICK_SR    0x02)  ; no sustain, instant release
(def ENV_SNARE_SR   0x01)  ; no sustain, instant release
(def ENV_HIHAT_SR   0x01)  ; no sustain, instant release
(def ENV_HIHAT_OPEN_SR 0x62); medium sustain, fast release (open hi-hat)
(def ENV_TOM_SR     0x02)  ; no sustain, instant release (toms)
(def ENV_CRASH_SR   0x08)  ; no sustain, medium release (crash)
(def ENV_RIDE_SR    0x42)  ; low sustain, fast release (ride)
(def ENV_BRASS_SR   0xC3)  ; high sustain, medium release
(def ENV_STRINGS_SR 0xE5)  ; very high sustain, slow release

; Legacy combined names (for backwards compatibility - use AD for env_ad, SR for env_sr)
(def ENV_SMOOTH     ENV_SMOOTH_AD)
(def ENV_PLUCK      ENV_PLUCK_AD)
(def ENV_ORGAN      ENV_ORGAN_AD)
(def ENV_KICK       ENV_KICK_AD)
(def ENV_SNARE      ENV_SNARE_AD)
(def ENV_HIHAT      ENV_HIHAT_AD)
(def ENV_BRASS      ENV_BRASS_AD)
(def ENV_STRINGS    ENV_STRINGS_AD)

; =============================================================================
; Master Control
; =============================================================================
(def APU_CTRL   (+ MMIO_BASE 0x40))
(def APU_STATUS (+ MMIO_BASE 0x41))

(defn init ()
  (store APU_CTRL 0x81))

(defn disable ()
  (store APU_CTRL 0x00))

; =============================================================================
; Channel Registers
; =============================================================================
; 4 channels, 6 bytes each: FREQ_LO, FREQ_HI, VOL, CTRL, ENV_AD, ENV_SR
; FREQ_HI: freq[2:0] | waveform[6:4]
; CTRL: enable[0], trigger[1]

(def CH0_FREQ_LO (+ MMIO_BASE 0x42))
(def CH0_FREQ_HI (+ MMIO_BASE 0x43))
(def CH0_VOL     (+ MMIO_BASE 0x44))
(def CH0_CTRL    (+ MMIO_BASE 0x45))
(def CH0_ENV_AD  (+ MMIO_BASE 0x46))
(def CH0_ENV_SR  (+ MMIO_BASE 0x47))

(def CH1_FREQ_LO (+ MMIO_BASE 0x48))
(def CH1_FREQ_HI (+ MMIO_BASE 0x49))
(def CH1_VOL     (+ MMIO_BASE 0x4A))
(def CH1_CTRL    (+ MMIO_BASE 0x4B))
(def CH1_ENV_AD  (+ MMIO_BASE 0x4C))
(def CH1_ENV_SR  (+ MMIO_BASE 0x4D))

(def CH2_FREQ_LO (+ MMIO_BASE 0x4E))
(def CH2_FREQ_HI (+ MMIO_BASE 0x4F))
(def CH2_VOL     (+ MMIO_BASE 0x50))
(def CH2_CTRL    (+ MMIO_BASE 0x51))
(def CH2_ENV_AD  (+ MMIO_BASE 0x52))
(def CH2_ENV_SR  (+ MMIO_BASE 0x53))

(def CH3_FREQ_LO (+ MMIO_BASE 0x54))
(def CH3_FREQ_HI (+ MMIO_BASE 0x55))
(def CH3_VOL     (+ MMIO_BASE 0x56))
(def CH3_CTRL    (+ MMIO_BASE 0x57))
(def CH3_ENV_AD  (+ MMIO_BASE 0x58))
(def CH3_ENV_SR  (+ MMIO_BASE 0x59))

(def CH0_LEN (+ MMIO_BASE 0x5A))
(def CH1_LEN (+ MMIO_BASE 0x5B))
(def CH2_LEN (+ MMIO_BASE 0x5C))
(def CH3_LEN (+ MMIO_BASE 0x5D))

(defn stop-all ()
  (store CH0_CTRL 0x00)
  (store CH1_CTRL 0x00)
  (store CH2_CTRL 0x00)
  (store CH3_CTRL 0x00))

(defn ch0-play (freq-lo freq-hi-wave vol duration)
  (store CH0_FREQ_LO freq-lo)
  (store CH0_FREQ_HI freq-hi-wave)
  (store CH0_VOL vol)
  (store CH0_LEN duration)
  (store CH0_CTRL 0x03))

(defn ch1-play (freq-lo freq-hi-wave vol duration)
  (store CH1_FREQ_LO freq-lo)
  (store CH1_FREQ_HI freq-hi-wave)
  (store CH1_VOL vol)
  (store CH1_LEN duration)
  (store CH1_CTRL 0x03))

(defn ch2-play (freq-lo freq-hi-wave vol duration)
  (store CH2_FREQ_LO freq-lo)
  (store CH2_FREQ_HI freq-hi-wave)
  (store CH2_VOL vol)
  (store CH2_LEN duration)
  (store CH2_CTRL 0x03))

(defn ch3-play (freq-lo freq-hi-wave vol duration)
  (store CH3_FREQ_LO freq-lo)
  (store CH3_FREQ_HI freq-hi-wave)
  (store CH3_VOL vol)
  (store CH3_LEN duration)
  (store CH3_CTRL 0x03))

(defn ch0-set-envelope (attack decay sustain release)
  (store CH0_ENV_AD (| (* attack 16) decay))
  (store CH0_ENV_SR (| (* sustain 16) release)))

(defn ch1-set-envelope (attack decay sustain release)
  (store CH1_ENV_AD (| (* attack 16) decay))
  (store CH1_ENV_SR (| (* sustain 16) release)))

(defn ch2-set-envelope (attack decay sustain release)
  (store CH2_ENV_AD (| (* attack 16) decay))
  (store CH2_ENV_SR (| (* sustain 16) release)))

(defn ch3-set-envelope (attack decay sustain release)
  (store CH3_ENV_AD (| (* attack 16) decay))
  (store CH3_ENV_SR (| (* sustain 16) release)))

; =============================================================================
; SFX System
; =============================================================================
; Entry format (6 bytes): channel, freq_lo, freq_hi|wave, volume, env_ad, duration

(def SFX_PLAY     (+ MMIO_BASE 0x90))
(def SFX_STOP     (+ MMIO_BASE 0x91))
(def SFX_STATUS   (+ MMIO_BASE 0x92))
(def SFX_TABLE_HI (+ MMIO_BASE 0x93))
(def SFX_TABLE_LO (+ MMIO_BASE 0x94))
(def SFX_COUNT    (+ MMIO_BASE 0x95))

(defn sfx-init (^u16 table count)
  (store SFX_TABLE_HI (hi table))
  (store SFX_TABLE_LO (lo table))
  (store SFX_COUNT count))

(defn sfx-play (sfx-id)
  (store SFX_PLAY sfx-id))

(defn sfx-stop (channel)
  (store SFX_STOP channel))

(defn sfx-status ()
  (load SFX_STATUS))

; =============================================================================
; Music Notes (C2-B6)
; =============================================================================
(def NOTE_REST 0)

(def NOTE_C2   1) (def NOTE_CS2  2) (def NOTE_D2   3) (def NOTE_DS2  4)
(def NOTE_E2   5) (def NOTE_F2   6) (def NOTE_FS2  7) (def NOTE_G2   8)
(def NOTE_GS2  9) (def NOTE_A2  10) (def NOTE_AS2 11) (def NOTE_B2  12)

(def NOTE_C3  13) (def NOTE_CS3 14) (def NOTE_D3  15) (def NOTE_DS3 16)
(def NOTE_E3  17) (def NOTE_F3  18) (def NOTE_FS3 19) (def NOTE_G3  20)
(def NOTE_GS3 21) (def NOTE_A3  22) (def NOTE_AS3 23) (def NOTE_B3  24)

(def NOTE_C4  25) (def NOTE_CS4 26) (def NOTE_D4  27) (def NOTE_DS4 28)
(def NOTE_E4  29) (def NOTE_F4  30) (def NOTE_FS4 31) (def NOTE_G4  32)
(def NOTE_GS4 33) (def NOTE_A4  34) (def NOTE_AS4 35) (def NOTE_B4  36)

(def NOTE_C5  37) (def NOTE_CS5 38) (def NOTE_D5  39) (def NOTE_DS5 40)
(def NOTE_E5  41) (def NOTE_F5  42) (def NOTE_FS5 43) (def NOTE_G5  44)
(def NOTE_GS5 45) (def NOTE_A5  46) (def NOTE_AS5 47) (def NOTE_B5  48)

(def NOTE_C6  49) (def NOTE_CS6 50) (def NOTE_D6  51) (def NOTE_DS6 52)
(def NOTE_E6  53) (def NOTE_F6  54) (def NOTE_FS6 55) (def NOTE_G6  56)
(def NOTE_GS6 57) (def NOTE_A6  58) (def NOTE_AS6 59) (def NOTE_B6  60)

; =============================================================================
; Dynamics
; =============================================================================
(def DYN_PPP  1)
(def DYN_PP   2)
(def DYN_P    3)
(def DYN_MP   4)
(def DYN_MF   5)
(def DYN_F    6)
(def DYN_FF   7)
(def DYN_FFF  8)

; =============================================================================
; Durations (frames at 60fps)
; =============================================================================
(def DUR_WHOLE     32)
(def DUR_HALF      16)
(def DUR_QUARTER    8)
(def DUR_EIGHTH     4)
(def DUR_SIXTEENTH  2)
(def DUR_THIRTYSEC  1)

(def DUR_DOTTED_HALF    24)
(def DUR_DOTTED_QUARTER 12)
(def DUR_DOTTED_EIGHTH   6)

(def DUR_TRIPLET_HALF    11)
(def DUR_TRIPLET_QUARTER  5)
(def DUR_TRIPLET_EIGHTH   3)

; =============================================================================
; Music System
; =============================================================================
; Track format (4 bytes per note):
;   note      - 0=rest, 1-60=C2 to B6 (use NOTE_ constants)
;   volume    - 0-15 (use DYN_ constants)
;   duration  - frames (use DUR_ constants)
;   waveform  - 0-7 (use WAVE_ constants)

(def MUSIC_CH0_ADDR_HI (+ MMIO_BASE 0x60))
(def MUSIC_CH0_ADDR_LO (+ MMIO_BASE 0x61))
(def MUSIC_CH0_LEN_HI  (+ MMIO_BASE 0x62))
(def MUSIC_CH0_LEN_LO  (+ MMIO_BASE 0x63))
(def MUSIC_CH0_CTRL    (+ MMIO_BASE 0x64))

(def MUSIC_CH1_ADDR_HI (+ MMIO_BASE 0x65))
(def MUSIC_CH1_ADDR_LO (+ MMIO_BASE 0x66))
(def MUSIC_CH1_LEN_HI  (+ MMIO_BASE 0x67))
(def MUSIC_CH1_LEN_LO  (+ MMIO_BASE 0x68))
(def MUSIC_CH1_CTRL    (+ MMIO_BASE 0x69))

(def MUSIC_CH2_ADDR_HI (+ MMIO_BASE 0x6A))
(def MUSIC_CH2_ADDR_LO (+ MMIO_BASE 0x6B))
(def MUSIC_CH2_LEN_HI  (+ MMIO_BASE 0x6C))
(def MUSIC_CH2_LEN_LO  (+ MMIO_BASE 0x6D))
(def MUSIC_CH2_CTRL    (+ MMIO_BASE 0x6E))

(def MUSIC_CH3_ADDR_HI (+ MMIO_BASE 0x6F))
(def MUSIC_CH3_ADDR_LO (+ MMIO_BASE 0x70))
(def MUSIC_CH3_LEN_HI  (+ MMIO_BASE 0x71))
(def MUSIC_CH3_LEN_LO  (+ MMIO_BASE 0x72))
(def MUSIC_CH3_CTRL    (+ MMIO_BASE 0x73))

(def MUSIC_STATUS (+ MMIO_BASE 0x74))

(defn music-ch0-play (^u16 addr ^u16 len loop)
  (store MUSIC_CH0_ADDR_HI (hi addr))
  (store MUSIC_CH0_ADDR_LO (lo addr))
  (store MUSIC_CH0_LEN_HI (hi len))
  (store MUSIC_CH0_LEN_LO (lo len))
  (store MUSIC_CH0_CTRL (| 0x01 (if loop 0x04 0x00))))

(defn music-ch1-play (^u16 addr ^u16 len loop)
  (store MUSIC_CH1_ADDR_HI (hi addr))
  (store MUSIC_CH1_ADDR_LO (lo addr))
  (store MUSIC_CH1_LEN_HI (hi len))
  (store MUSIC_CH1_LEN_LO (lo len))
  (store MUSIC_CH1_CTRL (| 0x01 (if loop 0x04 0x00))))

(defn music-ch2-play (^u16 addr ^u16 len loop)
  (store MUSIC_CH2_ADDR_HI (hi addr))
  (store MUSIC_CH2_ADDR_LO (lo addr))
  (store MUSIC_CH2_LEN_HI (hi len))
  (store MUSIC_CH2_LEN_LO (lo len))
  (store MUSIC_CH2_CTRL (| 0x01 (if loop 0x04 0x00))))

(defn music-ch3-play (^u16 addr ^u16 len loop)
  (store MUSIC_CH3_ADDR_HI (hi addr))
  (store MUSIC_CH3_ADDR_LO (lo addr))
  (store MUSIC_CH3_LEN_HI (hi len))
  (store MUSIC_CH3_LEN_LO (lo len))
  (store MUSIC_CH3_CTRL (| 0x01 (if loop 0x04 0x00))))

(defn music-ch0-stop ()
  (store MUSIC_CH0_CTRL 0x02))

(defn music-ch1-stop ()
  (store MUSIC_CH1_CTRL 0x02))

(defn music-ch2-stop ()
  (store MUSIC_CH2_CTRL 0x02))

(defn music-ch3-stop ()
  (store MUSIC_CH3_CTRL 0x02))

(defn music-stop ()
  (music-ch0-stop)
  (music-ch1-stop)
  (music-ch2-stop)
  (music-ch3-stop))

(defn music-playing ()
  (load MUSIC_STATUS))
