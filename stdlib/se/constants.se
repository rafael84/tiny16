; constants - hardware addresses and key codes
(ns constants)

; Memory map
(def OAM_ADDR           0x9000)
(def OAM_HI             (hi OAM_ADDR))
(def OAM_LO             (lo OAM_ADDR))
(def TILEMAP_ADDR       0x7000)
(def TILEMAP_HI         (hi TILEMAP_ADDR))
(def MMIO_BASE          0xBF00)

; Input/Output
(def KEYS_HELD          (+ MMIO_BASE 0x00))
(def KEYS_PRESSED       (+ MMIO_BASE 0x01))
(def KEYS_RELEASED      (+ MMIO_BASE 0x02))
(def MOUSE_X            (+ MMIO_BASE 0x10))
(def MOUSE_Y            (+ MMIO_BASE 0x11))
(def MOUSE_BUTTONS      (+ MMIO_BASE 0x12))
(def FRAME_COUNT        (+ MMIO_BASE 0x22))

; PPU
(def PPU_CTRL           (+ MMIO_BASE 0x30))
(def PPU_SCROLL_X       (+ MMIO_BASE 0x31))
(def PPU_SCROLL_Y       (+ MMIO_BASE 0x32))
(def PPU_BG_ONLY        0x01)
(def PPU_SPRITES_ONLY   0x02)
(def PPU_BG_SPRITES     0x03)
(def PPU_ENABLE         0x80)

; APU
(def APU_CTRL           (+ MMIO_BASE 0x40))
(def APU_STATUS         (+ MMIO_BASE 0x41))
(def APU_CH0_FREQ_LO    (+ MMIO_BASE 0x42))
(def APU_CH0_FREQ_HI    (+ MMIO_BASE 0x43))
(def APU_CH0_VOL        (+ MMIO_BASE 0x44))
(def APU_CH0_CTRL       (+ MMIO_BASE 0x45))
(def APU_CH0_ENV_AD     (+ MMIO_BASE 0x51))
(def APU_CH0_ENV_SR     (+ MMIO_BASE 0x52))
(def APU_CH0_LEN        (+ MMIO_BASE 0x5B))
(def APU_CH1_FREQ_LO    (+ MMIO_BASE 0x46))
(def APU_CH1_FREQ_HI    (+ MMIO_BASE 0x47))
(def APU_CH1_VOL        (+ MMIO_BASE 0x48))
(def APU_CH1_CTRL       (+ MMIO_BASE 0x49))
(def APU_CH1_ENV_AD     (+ MMIO_BASE 0x53))
(def APU_CH1_ENV_SR     (+ MMIO_BASE 0x54))
(def APU_CH1_LEN        (+ MMIO_BASE 0x5C))
(def APU_CH2_FREQ_LO    (+ MMIO_BASE 0x4A))
(def APU_CH2_FREQ_HI    (+ MMIO_BASE 0x4B))
(def APU_CH2_VOL        (+ MMIO_BASE 0x4C))
(def APU_CH2_CTRL       (+ MMIO_BASE 0x4D))
(def APU_CH2_ENV_AD     (+ MMIO_BASE 0x55))
(def APU_CH2_ENV_SR     (+ MMIO_BASE 0x56))
(def APU_CH2_LEN        (+ MMIO_BASE 0x5D))
(def APU_CH3_PERIOD     (+ MMIO_BASE 0x4E))
(def APU_CH3_VOL        (+ MMIO_BASE 0x4F))
(def APU_CH3_CTRL       (+ MMIO_BASE 0x50))
(def APU_CH3_ENV_AD     (+ MMIO_BASE 0x57))
(def APU_CH3_ENV_SR     (+ MMIO_BASE 0x58))
(def APU_CH3_LEN        (+ MMIO_BASE 0x5E))

; Key codes
(def KEY_UP             0x01)
(def KEY_DOWN           0x02)
(def KEY_A              0x04)
(def KEY_B              0x08)
(def KEY_LEFT           0x10)
(def KEY_RIGHT          0x20)
(def KEY_START          0x40)
(def KEY_SELECT         0x80)

; Graphics
(def TILE_SIZE          8)
(def SCREEN_WIDTH       128)
(def SCREEN_HEIGHT      128)
(def SCREEN_TILES       16)
(def NUM_SPRITES        64)
(def SPRITE_FLIP_H      0x01)
(def SPRITE_FLIP_V      0x02)
(def SPRITE_BEHIND_BG   0x20)
(def SPRITE_HIDDEN_Y    255)
