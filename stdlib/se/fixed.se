; fixed - 8.8 fixed-point operations using macros
; Format: high byte = integer part, low byte = fractional part (0-255)
(ns fixed)

; Set fixed-point value from integer: dest = val.0
; Usage: (fixed/set! bird_y 60) sets bird_y to 60.0
; Requires: {dest}_hi, {dest}_lo defined as data
(defmacro set! (dest val)
  (do
    (poke16 {dest}_hi {val})
    (poke16 {dest}_lo 0)))

; Set fixed-point value from hi.lo bytes: dest = hi.lo
; Usage: (fixed/set-raw! bird_vel 253 0) sets bird_vel to -3.0 (253 = -3 as signed byte)
(defmacro set-raw! (dest hi lo)
  (do
    (poke16 {dest}_hi {hi})
    (poke16 {dest}_lo {lo})))

; Add integer to fixed-point: dest += val
; Usage: (fixed/add-int! bird_vel 70) adds 70 to fractional part
; This is just an alias to word/add16i! for clarity
(defmacro add-int! (dest val)
  (let (lo (peek16 {dest}_lo)
        new-lo (+ lo (lo {val}))
        carry (if (< new-lo lo) 1 0)
        hi (peek16 {dest}_hi)
        new-hi (+ hi (+ (hi {val}) carry)))
    (poke16 {dest}_hi new-hi)
    (poke16 {dest}_lo new-lo)))

; Add two fixed-point values: dest += src
; Usage: (fixed/add! bird_y bird_vel)
; This is just an alias to word/add16! for clarity
(defmacro add! (dest src)
  (let (lo (peek16 {dest}_lo)
        src-lo (peek16 {src}_lo)
        new-lo (+ lo src-lo)
        carry (if (< new-lo lo) 1 0)
        hi (peek16 {dest}_hi)
        src-hi (peek16 {src}_hi)
        new-hi (+ hi (+ src-hi carry)))
    (poke16 {dest}_hi new-hi)
    (poke16 {dest}_lo new-lo)))

; Get integer part (high byte): returns {dest}_hi
; Usage: (fixed/int-part bird_y)
(defmacro int-part (dest)
  (peek16 {dest}_hi))

; Get fractional part (low byte): returns {dest}_lo
; Usage: (fixed/frac-part bird_y)
(defmacro frac-part (dest)
  (peek16 {dest}_lo))
