; core - timing, utilities, and low-level memory access (v2)
(ns core)

(def FRAME_COUNT 0xBF22)
(var last_frame 0)

; Read current frame count (~60 Hz, 8-bit wrapping)
(defn read-frame ()
  (load FRAME_COUNT))

; Wait for next frame (vsync)
(defn wait-frame ()
  (set! last_frame (read-frame))
  (while (= (read-frame) last_frame)
    0))

; --- Math utilities ---

(defn abs (x)
  (if (< x 0) (- 0 x) x))

(defn min (a b)
  (if (< a b) a b))

(defn max (a b)
  (if (> a b) a b))

(defn clamp (val min-val max-val)
  (if (< val min-val)
      min-val
      (if (> val max-val) max-val val)))

(defn sign (x)
  (if (< x 0) (- 0 1) (if (> x 0) 1 0)))

; --- Hi:lo memory access ---
; For hardware regions where the 16-bit address is naturally split into
; two 8-bit halves (tilemap pages, framebuffer scanlines, etc.).
; Use native store/load when the address fits (+ BASE u8_offset).

(defn poke (addr-hi addr-lo val)
  (asm "LOAD R6, [R4:R5 + 3]")
  (asm "LOAD R7, [R4:R5 + 4]")
  (asm "LOAD R0, [R4:R5 + 5]")
  (asm "STORE R0, [R6:R7]"))

(defn peek (addr-hi addr-lo)
  (asm "LOAD R6, [R4:R5 + 3]")
  (asm "LOAD R7, [R4:R5 + 4]")
  (asm "LOAD R0, [R6:R7]"))

; --- Convenience macros ---

(defmacro inc! (var)
  (set! {var} (inc {var})))

(defmacro dec! (var)
  (set! {var} (dec {var})))
