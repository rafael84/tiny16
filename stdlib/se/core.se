; core - timing and utilities
(ns core)

(def FRAME_COUNT 0xBF22)

; Read current frame count (~60 Hz)
(defn read-frame ()
  (peek16 FRAME_COUNT))

; Wait for next frame (vsync)
(defn wait-frame ()
  (let (last (peek16 last_frame)
        curr (read-frame))
    (while (= curr last)
      (set curr (read-frame)))
    (poke16 last_frame curr)))

(data last_frame (db 0))

; Absolute value
(defn abs (x)
  (if (< x 0) (- 0 x) x))

; Minimum of two values
(defn min (a b)
  (if (< a b) a b))

; Maximum of two values
(defn max (a b)
  (if (> a b) a b))

; Clamp value between min and max
(defn clamp (val min-val max-val)
  (if (< val min-val)
      min-val
      (if (> val max-val)
          max-val
          val)))

; Sign of a value: -1, 0, or 1
(defn sign (x)
  (if (< x 0)
      (- 0 1)
      (if (> x 0) 1 0)))
