; palette - color palette management (v2: native store/load)
(ns palette)

(def PALETTE_BASE 0x9200)

; Set palette color at index (0-255)
; color: RGB332 format (RRR GGG BB)
(defn set-color (index color)
  (store (+ PALETTE_BASE index) color))

; Get palette color at index
(defn get-color (index)
  (load (+ PALETTE_BASE index)))

; Fill entire palette with single color (all 256 entries)
; Uses wrapping u8 counter: set index 0, then loop 1..255
(defn fill (color)
  (set-color 0 color)
  (let (i 1)
    (while (!= i 0)
      (set-color i color)
      (set! i (inc i)))))
