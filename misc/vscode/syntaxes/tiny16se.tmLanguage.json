{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "tiny16 SE",
  "scopeName": "source.tiny16se",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#type-hints" },
    { "include": "#special-forms" },
    { "include": "#control-flow" },
    { "include": "#module-system" },
    { "include": "#namespace-definitions" },
    { "include": "#function-definitions" },
    { "include": "#macro-definitions" },
    { "include": "#record-definitions" },
    { "include": "#variable-definitions" },
    { "include": "#constant-definitions" },
    { "include": "#operators" },
    { "include": "#builtins" },
    { "include": "#type-casts" },
    { "include": "#special-literals" },
    { "include": "#booleans" },
    { "include": "#namespaced-symbols" },
    { "include": "#symbols" },
    { "include": "#parentheses" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.semicolon.tiny16se",
          "match": ";.*$",
          "captures": {
            "0": {
              "patterns": [
                {
                  "name": "keyword.codetag.notation.tiny16se",
                  "match": "\\b(TODO|FIXME|XXX|NOTE|HACK|BUG)\\b"
                }
              ]
            }
          }
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.tiny16se",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.tiny16se",
              "match": "\\\\[nrt\\\\\"0]"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.tiny16se",
          "match": "\\b0x[0-9a-fA-F]+\\b"
        },
        {
          "comment": "Fixed-point numbers (8.8 encoding)",
          "name": "constant.numeric.fixed-point.tiny16se",
          "match": "-?\\b\\d+\\.\\d+\\b"
        },
        {
          "name": "constant.numeric.decimal.tiny16se",
          "match": "-?\\b\\d+\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "comment": "Keywords starting with : (e.g. :alive, :dead, :x)",
          "name": "constant.other.keyword.tiny16se",
          "match": ":[a-zA-Z_\\-][a-zA-Z0-9_\\-]*"
        }
      ]
    },
    "type-hints": {
      "patterns": [
        {
          "comment": "Type hint annotations (^u8, ^i8, ^u16, ^i16)",
          "name": "storage.type.hint.tiny16se",
          "match": "\\^(u8|i8|u16|i16)\\b"
        }
      ]
    },
    "special-forms": {
      "patterns": [
        {
          "name": "keyword.control.tiny16se",
          "match": "(?<=\\()\\s*(def|defn|defmacro|defrecord|var|let|fn|set!)(?=\\s|\\))"
        }
      ]
    },
    "control-flow": {
      "patterns": [
        {
          "name": "keyword.control.flow.tiny16se",
          "match": "(?<=\\()\\s*(if|cond|when|unless|while|for|do)(?=\\s|\\))"
        }
      ]
    },
    "module-system": {
      "patterns": [
        {
          "name": "keyword.control.import.tiny16se",
          "match": "\\b(ns|require|import)\\b"
        }
      ]
    },
    "namespace-definitions": {
      "patterns": [
        {
          "match": "\\(\\s*(ns)\\s+([a-zA-Z_\\-][a-zA-Z0-9_\\-]*)",
          "captures": {
            "1": { "name": "keyword.control.import.tiny16se" },
            "2": { "name": "entity.name.namespace.tiny16se" }
          }
        }
      ]
    },
    "function-definitions": {
      "patterns": [
        {
          "match": "\\(\\s*(defn)\\s+([a-zA-Z_\\-][a-zA-Z0-9_\\-!?]*)",
          "captures": {
            "1": { "name": "keyword.control.tiny16se" },
            "2": { "name": "entity.name.function.tiny16se" }
          }
        }
      ]
    },
    "macro-definitions": {
      "patterns": [
        {
          "match": "\\(\\s*(defmacro)\\s+([a-zA-Z_\\-][a-zA-Z0-9_\\-!?]*)",
          "captures": {
            "1": { "name": "keyword.control.tiny16se" },
            "2": { "name": "entity.name.function.macro.tiny16se" }
          }
        }
      ]
    },
    "record-definitions": {
      "patterns": [
        {
          "match": "\\(\\s*(defrecord)\\s+([a-zA-Z_\\-][a-zA-Z0-9_\\-]*)",
          "captures": {
            "1": { "name": "keyword.control.tiny16se" },
            "2": { "name": "entity.name.type.record.tiny16se" }
          }
        }
      ]
    },
    "variable-definitions": {
      "patterns": [
        {
          "match": "\\(\\s*(var)\\s+\\^(?:u8|i8|u16|i16)\\s+([a-zA-Z_\\-][a-zA-Z0-9_\\-]*)",
          "captures": {
            "1": { "name": "keyword.control.tiny16se" },
            "2": { "name": "variable.other.definition.tiny16se" }
          }
        },
        {
          "match": "\\(\\s*(var)\\s+([a-zA-Z_\\-][a-zA-Z0-9_\\-]*)",
          "captures": {
            "1": { "name": "keyword.control.tiny16se" },
            "2": { "name": "variable.other.definition.tiny16se" }
          }
        }
      ]
    },
    "constant-definitions": {
      "patterns": [
        {
          "match": "\\(\\s*(def)\\s+([a-zA-Z_\\-][a-zA-Z0-9_\\-]*)",
          "captures": {
            "1": { "name": "keyword.control.tiny16se" },
            "2": { "name": "constant.other.tiny16se" }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.tiny16se",
          "match": "(?<=\\()\\s*(\\+|\\-|\\*|/|%|&|\\||\\^|~|<<|>>|=|!=|<=|>=|<|>)(?=\\s)"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "comment": "Arithmetic builtins",
          "name": "support.function.builtin.tiny16se",
          "match": "(?<=\\()\\s*(inc|dec)(?=\\s|\\))"
        },
        {
          "comment": "Logic (short-circuit)",
          "name": "support.function.builtin.tiny16se",
          "match": "(?<=\\()\\s*(and|or|not)(?=\\s|\\))"
        },
        {
          "comment": "Type predicates",
          "name": "support.function.builtin.tiny16se",
          "match": "(?<=\\()\\s*(nil\\?|zero\\?|pos\\?|neg\\?)(?=\\s|\\))"
        },
        {
          "comment": "Memory access",
          "name": "support.function.builtin.tiny16se",
          "match": "(?<=\\()\\s*(load|store|hi|lo)(?=\\s|\\))"
        },
        {
          "comment": "Array and collection builtins",
          "name": "support.function.builtin.tiny16se",
          "match": "(?<=\\()\\s*(nth|len|array|range)(?=\\s|\\))"
        },
        {
          "comment": "Inline assembly",
          "name": "support.function.builtin.tiny16se",
          "match": "(?<=\\()\\s*(asm)(?=\\s|\\))"
        }
      ]
    },
    "type-casts": {
      "patterns": [
        {
          "comment": "Type cast functions (u8 expr), (i8 expr)",
          "name": "support.type.cast.tiny16se",
          "match": "(?<=\\()\\s*(u8|i8)(?=\\s|\\))"
        }
      ]
    },
    "special-literals": {
      "patterns": [
        {
          "name": "constant.language.nil.tiny16se",
          "match": "\\bnil\\b"
        }
      ]
    },
    "booleans": {
      "patterns": [
        {
          "name": "constant.language.boolean.tiny16se",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "namespaced-symbols": {
      "patterns": [
        {
          "comment": "Namespaced symbols like apu/init, sprite/draw, apu/NOTE_C4",
          "match": "\\b([a-zA-Z_\\-][a-zA-Z0-9_\\-]*)(/)([a-zA-Z_\\-][a-zA-Z0-9_\\-!?]*)\\b",
          "captures": {
            "1": { "name": "entity.name.namespace.tiny16se" },
            "2": { "name": "punctuation.accessor.tiny16se" },
            "3": { "name": "variable.other.member.tiny16se" }
          }
        }
      ]
    },
    "symbols": {
      "patterns": [
        {
          "name": "variable.other.tiny16se",
          "match": "[a-zA-Z_\\-][a-zA-Z0-9_\\-!?]*"
        }
      ]
    },
    "parentheses": {
      "patterns": [
        {
          "name": "punctuation.section.parens.tiny16se",
          "match": "[()]"
        }
      ]
    }
  }
}
